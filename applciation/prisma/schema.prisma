  section      ProfileSection?
  subject      String
  status       TicketStatus    @default(OPEN)
  assigneeId   String?         @db.Uuid
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  resolvedAt   DateTime?

