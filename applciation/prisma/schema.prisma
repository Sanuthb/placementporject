  collegeId String   @db.Uuid
  studentId String   @db.Uuid
  actorId   String   @db.Uuid
  createdAt DateTime @default(now())

  @@index([studentId, createdAt])
  @@index([actorId, studentId, createdAt])
}

// Every time staff open an individual result.
model PsychAccessLog {
  id        String   @id @default(uuid()) @db.Uuid
  collegeId String   @db.Uuid
  actorId   String   @db.Uuid
  studentId String   @db.Uuid
  reason    String
  createdAt DateTime @default(now())

  @@index([collegeId, createdAt])
  @@index([studentId])
}

// ---------- Employer CRM ----------
model Prospect {
  id             String        @id @default(uuid()) @db.Uuid
  collegeId      String        @db.Uuid
  companyName    String
  industry       String?
  contactName    String?
