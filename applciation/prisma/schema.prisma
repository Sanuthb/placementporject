// ---------- Student preparation ----------
model PrepResource {
  id          String           @id @default(uuid()) @db.Uuid
  collegeId   String           @db.Uuid
  title       String
  category    ResourceCategory
  url         String
  description String?
  isActive    Boolean          @default(true)
  createdAt   DateTime         @default(now())

  @@index([collegeId, isActive])
}

model CounsellingSlot {
  id           String    @id @default(uuid()) @db.Uuid
  collegeId    String    @db.Uuid
  counsellorId String    @db.Uuid
  startsAt     DateTime
  endsAt       DateTime
  status       SlotState @default(OPEN)
  studentId    String?   @db.Uuid
  topic        String?
  notes        String?
  createdAt    DateTime  @default(now())

  counsellor User     @relation(fields: [counsellorId], references: [id])
  student    Student? @relation(fields: [studentId], references: [id])

  @@index([collegeId, status, startsAt])
}

model InterviewExperience {
  id             String           @id @default(uuid()) @db.Uuid
  collegeId      String           @db.Uuid
  studentId      String           @db.Uuid
  companyName    String
  role           String
  roundType      RoundType?
  experience     String
  difficulty     Int
  status         ModerationStatus @default(PENDING)
  moderatedById  String?          @db.Uuid
  moderationNote String?
  createdAt      DateTime         @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([collegeId, status, createdAt])
}

// ---------- Recruiter portal ----------
model Recruiter {
  id        String   @id @db.Uuid
  collegeId String   @db.Uuid
  companyId String   @db.Uuid
  email     String
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  company Company        @relation(fields: [companyId], references: [id])
  jobs    RecruiterJob[]

  @@unique([collegeId, email])
  @@index([companyId])
}

model RecruiterJob {
  id           String             @id @default(uuid()) @db.Uuid
  collegeId    String             @db.Uuid
  recruiterId  String             @db.Uuid
  title        String
  jobType      JobType
  location     String?
  description  String?
  applyUrl     String
  deadline     DateTime?
  status       RecruiterJobStatus @default(PENDING_REVIEW)
  reviewedById String?            @db.Uuid
  reviewNote   String?
  jobAlertId   String?            @db.Uuid
  createdAt    DateTime           @default(now())

  recruiter Recruiter @relation(fields: [recruiterId], references: [id])

  @@index([collegeId, status])
}

// ---------- Talent showcase ----------
model ShowcaseProfile {
  id          String    @id @default(uuid()) @db.Uuid
  collegeId   String    @db.Uuid
  studentId   String    @unique @db.Uuid
  token       String    @unique
  isEnabled   Boolean   @default(true)
  headline    String?
  showCgpa    Boolean   @default(false)
  showContact Boolean   @default(false)
  expiresAt   DateTime?
  views       Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([collegeId, isEnabled])
}

// Fixed-window counters for rate limiting. Shared by every server instance, so limits hold behind a load balancer.
model RateLimitBucket {
  key         String
  windowStart BigInt
  count       Int      @default(1)
  createdAt   DateTime @default(now())

  @@id([key, windowStart])
  @@index([createdAt])
}

/// One row per previous or current qualification (SSLC, PUC, BCA, MCA ...).
model StudentEducationRecord {
  id                String          @id @default(uuid()) @db.Uuid
  collegeId         String          @db.Uuid
  studentId         String          @db.Uuid
  level             String
  qualification     String
  specialisation    String?
  institution       String
  boardOrUniversity String?
  rollNo            String?
  admissionYear     Int?
  completionYear    Int?
  percentage        Decimal?        @db.Decimal(5, 2)
  cgpa              Decimal?        @db.Decimal(4, 2)
  maxMarks          Int?
  obtainedMarks     Int?
  backlogs          Int             @default(0)
  status            EducationStatus @default(COMPLETED)
  isCurrent         Boolean         @default(false)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([collegeId, studentId])
}

/// A single uploaded academic document with its own verification state.
model StudentDocument {
  id           String          @id @default(uuid()) @db.Uuid
  collegeId    String          @db.Uuid
  studentId    String          @db.Uuid
  category     DocCategory
  storagePath  String
  fileName     String
  mimeType     String
  sizeBytes    Int
  status       DocVerification @default(PENDING)
  verifiedById String?         @db.Uuid
  verifiedAt   DateTime?
  rejectReason String?
  createdAt    DateTime        @default(now())

  student    Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  verifiedBy User?   @relation(fields: [verifiedById], references: [id])

  @@index([collegeId, studentId])
  @@index([collegeId, status])
}

/// History of a student moving through semesters. Rows are only added, never overwritten.
model StudentProgression {
  id             String          @id @default(uuid()) @db.Uuid
  collegeId      String          @db.Uuid
  studentId      String          @db.Uuid
  semesterId     String?         @db.Uuid
  academicYearId String?         @db.Uuid
  kind           ProgressionKind
  note           String?
  createdById    String?         @db.Uuid
  createdAt      DateTime        @default(now())

  student  Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  semester Semester? @relation(fields: [semesterId], references: [id])

  @@index([collegeId, studentId, createdAt])
}
