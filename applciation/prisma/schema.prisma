  prospectId String   @db.Uuid
  authorId   String   @db.Uuid
  kind       String
  body       String
  createdAt  DateTime @default(now())

  prospect Prospect @relation(fields: [prospectId], references: [id], onDelete: Cascade)

  @@index([prospectId, createdAt])
}

// ---------- Internships ----------
model Internship {
  id                    String            @id @default(uuid()) @db.Uuid
  collegeId             String            @db.Uuid
  studentId             String            @db.Uuid
  companyId             String?           @db.Uuid
  companyName           String
  role                  String
  startDate             DateTime          @db.Date
  endDate               DateTime          @db.Date
  mentorName            String?
  mentorEmail           String?
  postingId             String?           @db.Uuid
  applicationId         String?           @unique @db.Uuid
  /// The faculty member who follows the student through the internship (the company's own mentor is mentorName / mentorEmail).
  facultyMentorId       String?           @db.Uuid
  /// Working days, 0 = Sunday to 6 = Saturday, and hours in a normal day.
  workDays              Int[]             @default([1, 2, 3, 4, 5])
  hoursPerDay           Int               @default(8)
  scheduleNote          String?
  stipendInr            Int?
  certificatePath       String?
  certificateName       String?
  certificateMime       String?
  certificateStatus     CertificateStatus @default(NONE)
  certificateNote       String?
  certificateUploadedAt DateTime?
  ppoStatus             PpoStatus         @default(NONE)
  ppoOfferId            String?           @db.Uuid
  ppoNote               String?
  completedAt           DateTime?
  /// Set when an admin completed the internship although a required check was not met.
  completionOverride    String?
  status                InternshipStatus  @default(ALLOTTED)
  createdById           String            @db.Uuid
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  student     Student                @relation(fields: [studentId], references: [id], onDelete: Cascade)
  logs        WorkLog[]
  evaluations InternshipEvaluation[]
  attendance  InternshipAttendance[]
  tasks       InternshipTask[]
  feedback    InternshipFeedback[]
  links       InternshipMentorLink[]

  @@index([collegeId, status])
  @@index([studentId])
}

model WorkLog {
