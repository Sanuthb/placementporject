model AssessmentAttempt {
  id            String        @id @default(uuid()) @db.Uuid
  scheduleId    String        @db.Uuid
  studentId     String        @db.Uuid
  startedAt     DateTime      @default(now())
  deadlineAt    DateTime
  submittedAt   DateTime?
  answers       Json          @default("{}")
  score         Decimal?      @db.Decimal(8, 2)
  maxScore      Decimal?      @db.Decimal(8, 2)
  violations    Int           @default(0)
  flagged       Boolean       @default(false)
  proctorEvents Json          @default("[]")
  status        AttemptStatus @default(IN_PROGRESS)
  /// 1 for the first attempt; retakes (when the category's rule allows them) count up. Earlier attempts are kept.
  attemptNumber Int           @default(1)
  /// Marks given to descriptive, coding and SQL answers: { questionId: { awarded, by: "AI" | "STAFF", comment } }.
  marks         Json?
  /// NONE, PENDING (an open answer is waiting for a mark; the score is provisional) or DONE.
  reviewStatus  String        @default("NONE")

  schedule AssessmentSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  student  Student            @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([scheduleId, studentId, attemptNumber])
  @@index([scheduleId, studentId])
  @@index([studentId])
}

// ---------- Student preparation ----------
enum ResourceType {
  DOCUMENT
  IMAGE
  VIDEO
  AUDIO
  VIDEO_LINK
  WEBSITE
  QUESTION_BANK
  SAMPLE_TEST
  CODING_PRACTICE
  COMPANY_MATERIAL
}

enum ResourceStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  REJECTED
  ARCHIVED
}

/// ALL_STUDENTS: in the library for every student. ASSIGNED_ONLY: only students it was assigned to. STAFF_ONLY: never shown to students.
enum ResourceVisibility {
  ALL_STUDENTS
  ASSIGNED_ONLY
  STAFF_ONLY
}

enum ResourceDifficulty {
  EASY
  MEDIUM
  HARD
}

enum ResourceTarget {
  STUDENT
  DEPARTMENT
  BATCH
  GROUP
  SKILL_GAP
  MOCK_TEST
}

/// A preparation resource: a file or a link, with metadata, an approval workflow, versions and assignments. Students see only approved, unexpired ones.
model PrepResource {
  id           String              @id @default(uuid()) @db.Uuid
  collegeId    String              @db.Uuid
  title        String
  category     ResourceCategory
  type         ResourceType        @default(WEBSITE)
  url          String?
  filePath     String?
  fileName     String?
  mimeType     String?
  sizeBytes    Int?
  description  String?
  subject      String?
  topic        String?
  skills       String[]
  jobRoles     String[]
  companyName  String?
  difficulty   ResourceDifficulty?
  language     String              @default("English")
  durationMin  Int?
  status       ResourceStatus      @default(DRAFT)
  version      Int                 @default(1)
  expiresAt    DateTime?
  visibility   ResourceVisibility  @default(ASSIGNED_ONLY)
  uploadedById String?             @db.Uuid
  reviewedById String?             @db.Uuid
  reviewedAt   DateTime?
  reviewNote   String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @default(now()) @updatedAt

  versions    ResourceVersion[]
  assignments ResourceAssignment[]
  progress    ResourceProgress[]

