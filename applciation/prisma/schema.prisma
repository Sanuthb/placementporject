// Fixed-window counters for rate limiting. Shared by every server instance, so limits hold behind a load balancer.
model RateLimitBucket {
  key         String
  windowStart BigInt
  count       Int      @default(1)
  createdAt   DateTime @default(now())

  @@id([key, windowStart])
  @@index([createdAt])
}

/// One row per scheduled job per schedule slot (Gate 4 Phase 4.3 monitoring). A scheduler retry or a concurrent duplicate of the same slot
/// updates this row (attempts + 1) instead of adding another. Holds counts and a sanitized failure note only: never a credential, token or person.
/// Deleted after 90 days (lib/monitorRetention.ts). No foreign keys, so it can be dropped without touching anything else.
model JobRun {
  id             String    @id @default(uuid()) @db.Uuid
  job            String
  trigger        String    @default("scheduler")
  /// The schedule slot this run belongs to (the most recent time the job's cron expression matched), in UTC.
  slotAt         DateTime
  /// When the first attempt for the slot began.
  startedAt      DateTime  @default(now())
  /// When the most recent attempt began. Later than finishedAt means an attempt is still running (or was cut off).
  lastStartedAt  DateTime  @default(now())
  /// When the most recent attempt ended. Null until one has ended.
  finishedAt     DateTime?
  /// Outcome of the most recent finished attempt. Null until one has finished.
  ok             Boolean?
  durationMs     Int?
  attempts       Int       @default(1)
  failedAttempts Int       @default(0)
  /// Numeric counts the job returned (for example { colleges: 3, reminded: 12 }). Nothing else is ever stored here.
  summary        Json?
  /// Sanitized failure note, at most 300 characters.
  error          String?

  @@unique([job, slotAt])
  @@index([slotAt])
}

/// A durable record of a server-side failure (HTTP 5xx or a service-unavailable code), written by lib/monitorStore.ts after the message has been
/// scrubbed. Replaces the per-instance in-memory list as the source for the System Administrator error view. Deleted after 14 days.
model MonitorEvent {
  id        String   @id @default(uuid()) @db.Uuid
  at        DateTime @default(now())
  service   String
  status    Int?
  code      String
  method    String?
  /// Identifiers and link tokens already replaced with :id / :token.
  path      String?
  requestId String?
  /// Scrubbed of credentials, addresses and long opaque strings; first line only; at most 240 characters.
  message   String

  @@index([at])
  @@index([service, at])
}

enum AiProvider {
  GROQ
  ANTHROPIC
}

/// What an AI call is for. Each purpose can be configured (provider, model, key, on/off) on its own: text work, reading images, and the interview engine.
enum AiPurpose {
  TEXT
  VISION
  INTERVIEW
}

/// Platform-wide AI configuration (Phase 4.4.2), at most one row per purpose. Precedence at run time: an active row here, else environment variables, else the built-in defaults
/// (lib/ai/config.ts). `enabled = false` is the per-purpose kill switch (the purpose is OFF, it does not fall back). Deleting the row returns the purpose to the environment.
/// The API key is stored only as AES-256-GCM ciphertext (`keyCiphertext`, versioned envelope, authenticated against this row's id and purpose); it is never stored, returned or logged in
/// plaintext, and `keyLast4` is the only part shown. No foreign keys: the table can be dropped without touching anything else. Row-level security is on and nothing is granted to public roles.
model AiProviderConfig {
  id            String     @id @default(uuid()) @db.Uuid
  purpose       AiPurpose  @unique
  provider      AiProvider
  model         String
  enabled       Boolean    @default(true)
  /// Versioned envelope "aigcm1.<masterKeyVersion>.<iv>.<tag>.<ciphertext>" (base64url). Null: no key stored for this purpose, the provider's environment key is used.
  keyCiphertext String?
  /// Master-key version that encrypted `keyCiphertext` (also inside the envelope); lets rotation progress be counted without decrypting anything.
  keyVersion    Int?
  /// The last four characters of the key, for display only (null when the key is too short to show any part safely).
  keyLast4      String?
  keyUpdatedAt  DateTime?
  keyUpdatedBy  String?    @db.Uuid
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  updatedBy     String?    @db.Uuid

  @@index([keyVersion])
}

/// The platform-wide AI kill switch (Phase 4.4.3): one row, id "global" (enforced by a CHECK constraint in the migration). `enabled = false` switches ALL AI features off at once, whatever any
/// per-purpose configuration says; there is no fallback to the environment. No row means on. `reason` is free text for administrators and never holds a credential or personal data.
model AiGlobalSetting {
  id        String   @id @default("global")
  enabled   Boolean  @default(true)
  reason    String?
  updatedAt DateTime @updatedAt
  updatedBy String?  @db.Uuid
}

/// Platform-wide policy (Gate 4, SA-TC-012): one row, id "platform". A minimum two-step sign-in rule for institution administrators that an institution may tighten but never weaken, and
/// retention periods (days) for the platform's own operational records. A null period means "use the built-in default" (job history 90, monitoring events 14, AI usage statistics 90).
/// No student or institution data is governed here.
model PlatformPolicy {
  id                       String   @id @default("platform")
  requireAdminMfa          Boolean  @default(false)
  retentionJobRunDays      Int?
  retentionMonitorEventDays Int?
  retentionAiUsageDays     Int?
  updatedAt                DateTime @updatedAt
  updatedBy                String?  @db.Uuid
}

/// Daily AI usage, aggregated: counts and latency only. Never a prompt, an answer, a transcript or a person. One row per day, institution (or "platform" for calls outside any
/// institution), purpose, provider, model and feature; written by a concurrency-safe upsert (Phase 4.4.5). `collegeKey` is a college id or "platform" and is not a foreign key,
/// so usage history survives the removal of an institution.
model AiUsageDaily {
  id          String     @id @default(uuid()) @db.Uuid
  day         DateTime   @db.Date
  collegeKey  String
  purpose     AiPurpose
  provider    AiProvider
  model       String
  feature     String
  calls       Int        @default(0)
  failures    Int        @default(0)
  timeouts    Int        @default(0)
  rateLimited Int        @default(0)
  /// Calls refused by a daily limit before they were sent (not part of `calls`).
  blocked     Int        @default(0)
  /// Sum of call durations, so an average can be shown without keeping individual calls.
  totalMs     BigInt     @default(0)
  updatedAt   DateTime   @updatedAt

  @@unique([day, collegeKey, purpose, provider, model, feature])
  @@index([collegeKey, day])
  @@index([day])
}

enum AiLimitKind {
  COLLEGE_DEFAULT
  COLLEGE
  PROVIDER
  PURPOSE
}

/// A configured daily AI call limit (Phase 4.4.5). No row means no limit: the platform ships with none and invents none. Kinds and their keys:
/// COLLEGE_DEFAULT "*" (every institution without its own row), COLLEGE <college id>, PROVIDER GROQ|ANTHROPIC (platform-wide), PURPOSE TEXT|VISION|INTERVIEW (platform-wide).
/// `dailyCalls = 0` blocks the scope entirely. No foreign keys.
model AiLimit {
  id         String      @id @default(uuid()) @db.Uuid
  kind       AiLimitKind
  key        String
  dailyCalls Int
  updatedAt  DateTime    @updatedAt
  updatedBy  String?     @db.Uuid

  @@unique([kind, key])
}

/// The per-day counter that makes limits safe under concurrency: a call reserves its place with one conditional upsert per scope ("college:<id>", "provider:GROQ", "purpose:TEXT")
/// inside a transaction, so two simultaneous calls can never both take the last slot. Counts attempts; holds no content. Kept 3 days.
model AiQuotaCounter {
  id        String   @id @default(uuid()) @db.Uuid
  day       DateTime @db.Date
  scope     String
  used      Int      @default(0)
  updatedAt DateTime @updatedAt

  @@unique([day, scope])
  @@index([day])
}

/// One row per previous or current qualification (SSLC, PUC, BCA, MCA ...).
model StudentEducationRecord {
  id                String          @id @default(uuid()) @db.Uuid
  collegeId         String          @db.Uuid
  studentId         String          @db.Uuid
  level             String
  qualification     String
  specialisation    String?
  institution       String
  boardOrUniversity String?
  rollNo            String?
  admissionYear     Int?
  completionYear    Int?
  percentage        Decimal?        @db.Decimal(5, 2)
  cgpa              Decimal?        @db.Decimal(4, 2)
  maxMarks          Int?
  obtainedMarks     Int?
  backlogs          Int             @default(0)
  status            EducationStatus @default(COMPLETED)
  isCurrent         Boolean         @default(false)
  // Review state, moved together with the student's EDUCATION_HISTORY section. An edit to a verified record waits in `pendingData`.
  reviewStatus      SectionStatus   @default(DRAFT)
  reviewComment     String?
  pendingData       Json?
  verifiedAt        DateTime?
  verifiedById      String?         @db.Uuid
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([collegeId, studentId])
}

enum ResultStatus {
  PASS
  FAIL
  WITHHELD
  ONGOING
}

enum AttemptOutcome {
  FAILED
  CLEARED
}

/// One semester of the degree. Moves through review with the student's ACADEMICS section. The percentage is never stored: it is worked out from the subject marks.
model SemesterResult {
  id             String        @id @default(uuid()) @db.Uuid
  collegeId      String        @db.Uuid
  studentId      String        @db.Uuid
  // The M2 semester this result belongs to, when the student's batch has one with this number.
  semesterId     String?       @db.Uuid
  semesterNumber Int
  sgpa           Decimal?      @db.Decimal(4, 2)
  resultStatus   ResultStatus  @default(PASS)
  reviewStatus   SectionStatus @default(DRAFT)
  reviewComment  String?
  // A proposed change to a verified semester (same shape as the input). Applied only when staff approve.
  pendingData    Json?
  verifiedAt     DateTime?
  verifiedById   String?       @db.Uuid
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  student  Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  semester Semester?     @relation(fields: [semesterId], references: [id])
  subjects SubjectMark[]

  @@unique([studentId, semesterNumber])
  @@index([collegeId, studentId])
}

model SubjectMark {
  id               String   @id @default(uuid()) @db.Uuid
  collegeId        String   @db.Uuid
  semesterResultId String   @db.Uuid
  code             String?
  name             String
  marksObtained    Decimal  @db.Decimal(7, 2)
  maxMarks         Decimal  @db.Decimal(7, 2)
  credits          Decimal? @db.Decimal(4, 1)
  grade            String?
  gradePoints      Decimal? @db.Decimal(4, 2)

  semesterResult SemesterResult @relation(fields: [semesterResultId], references: [id], onDelete: Cascade)

  @@index([semesterResultId])
}

/// A subject the student has failed. Attempts are only ever added: clearing the subject adds a CLEARED attempt, it never erases the earlier ones.
model Backlog {
  id             String   @id @default(uuid()) @db.Uuid
  collegeId      String   @db.Uuid
  studentId      String   @db.Uuid
  subjectName    String
  subjectCode    String?
  semesterNumber Int
  createdAt      DateTime @default(now())

  student  Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  attempts BacklogAttempt[]

  @@unique([studentId, semesterNumber, subjectName])
  @@index([collegeId, studentId])
}

model BacklogAttempt {
  id                String         @id @default(uuid()) @db.Uuid
  collegeId         String         @db.Uuid
  backlogId         String         @db.Uuid
  attemptNumber     Int
  examSession       String?
  marksObtained     Decimal?       @db.Decimal(7, 2)
  outcome           AttemptOutcome
  clearedInSemester Int?
  reviewStatus      SectionStatus  @default(DRAFT)
  reviewComment     String?
  verifiedAt        DateTime?
  verifiedById      String?        @db.Uuid
  createdAt         DateTime       @default(now())

  backlog Backlog @relation(fields: [backlogId], references: [id], onDelete: Cascade)

  @@unique([backlogId, attemptNumber])
}

/// A single uploaded academic document with its own verification state.
model StudentDocument {
  id            String          @id @default(uuid()) @db.Uuid
  collegeId     String          @db.Uuid
  studentId     String          @db.Uuid
  category      DocCategory
  storagePath   String
  fileName      String
  mimeType      String
  sizeBytes     Int
  status        DocVerification @default(PENDING)
  verifiedById  String?         @db.Uuid
  verifiedAt    DateTime?
  rejectReason  String?
  createdAt     DateTime        @default(now())
  /// SHA-256 of the file bytes: stops the same file being uploaded twice and proves a replacement really differs.
  sha256        String?
  /// The document this one replaced. The older file is kept, archived, and never removed from storage.
  replacesId    String?         @db.Uuid
  /// Set when the document is removed or replaced. Archived rows stay for history and audit; every live view filters them out.
  archivedAt    DateTime?
  archivedById  String?         @db.Uuid
  archiveReason String?

  student     Student              @relation(fields: [studentId], references: [id], onDelete: Cascade)
  verifiedBy  User?                @relation(fields: [verifiedById], references: [id])
  extractions DocumentExtraction[]

  @@index([collegeId, studentId])
  @@index([collegeId, status])
  @@index([studentId, sha256])
}

enum ExtractionStatus {
  DONE
  FAILED
}

/// What the AI read from one document, and the suggestions made from it. Never verifies anything: a suggestion only fills the student's draft
/// when the student accepts it, and staff still check the document by eye. Rows are kept (newest wins) for audit.
model DocumentExtraction {
  id            String           @id @default(uuid()) @db.Uuid
  collegeId     String           @db.Uuid
  studentId     String           @db.Uuid
  documentId    String           @db.Uuid
  status        ExtractionStatus
  model         String
  /// The fields as read, after validation. Null when the read failed.
  fields        Json?
  /// Comparisons with the student's records: [{ key, kind, label, current, suggested, state }].
  suggestions   Json             @default("[]")
  error         String?
  /// Null when the student asked for the read.
  requestedById String?          @db.Uuid
  createdAt     DateTime         @default(now())

  document StudentDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId, createdAt])
  @@index([collegeId, studentId])
}

/// History of a student moving through semesters. Rows are only added, never overwritten.
model StudentProgression {
  id             String          @id @default(uuid()) @db.Uuid
  collegeId      String          @db.Uuid
  studentId      String          @db.Uuid
  semesterId     String?         @db.Uuid
  academicYearId String?         @db.Uuid
  kind           ProgressionKind
  note           String?
  createdById    String?         @db.Uuid
  createdAt      DateTime        @default(now())

  student  Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  semester Semester? @relation(fields: [semesterId], references: [id])

  @@index([collegeId, studentId, createdAt])
}

/// A campus of the institution. Optional: a single-campus college can leave it empty.
model Campus {
  id        String   @id @default(uuid()) @db.Uuid
  collegeId String   @db.Uuid
  name      String
  code      String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  college     College             @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  students    Student[]
  invitations StudentInvitation[]

  @@unique([collegeId, name])
}

/// One invitation per student. The token itself is never stored, only its SHA-256 hash. Resending or copying a link issues a new token and
/// invalidates the old one. The assigned academic structure is copied here so the invitation shows what the student was told.
model StudentInvitation {
  id              String           @id @default(uuid()) @db.Uuid
  collegeId       String           @db.Uuid
  studentId       String           @unique @db.Uuid
  invitedEmail    String
  admissionNumber String
  campusId        String?          @db.Uuid
  departmentId    String           @db.Uuid
  programId       String?          @db.Uuid
  branchId        String?          @db.Uuid
  batchId         String           @db.Uuid
  admissionYear   Int?
  graduationYear  Int?
  tokenHash       String           @unique
  expiresAt       DateTime
  status          InvitationStatus @default(PENDING)
  sentAt          DateTime?
  acceptedAt      DateTime?
  lastResentAt    DateTime?
  resendCount     Int              @default(0)
  failedAttempts  Int              @default(0)
  revokedAt       DateTime?
  createdById     String?          @db.Uuid
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  college College              @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  student Student              @relation(fields: [studentId], references: [id], onDelete: Cascade)
  campus  Campus?              @relation(fields: [campusId], references: [id])
  emails  InvitationEmailLog[]

  @@index([collegeId, status])
  @@index([status, expiresAt])
}

/// What the student has entered in the onboarding wizard so far. Saved as a draft at every step; copied into the
/// verified profile sections only when the student submits.
model StudentOnboardingProfile {
  id                    String    @id @default(uuid()) @db.Uuid
  collegeId             String    @db.Uuid
  studentId             String    @unique @db.Uuid
  currentStep           Int       @default(1)
  personal              Json      @default("{}")
  academics             Json      @default("{}")
  career                Json      @default("{}")
  declarationAcceptedAt DateTime?
  declarationText       String?
  submittedAt           DateTime?
  proposedName          String?
  nameDecidedAt         DateTime?
  reviewNote            String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([collegeId])
}

/// A student asking staff to fix something they were assigned (department, batch...). Students never edit those fields themselves.
model StudentCorrectionRequest {
  id           String        @id @default(uuid()) @db.Uuid
  collegeId    String        @db.Uuid
  studentId    String        @db.Uuid
  field        String
  message      String
  status       RequestStatus @default(PENDING)
  resolvedById String?       @db.Uuid
  resolvedAt   DateTime?
  createdAt    DateTime      @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([collegeId, status])
  @@index([studentId])
}

/// One row per invitation email attempt. Holds no token or link.
model InvitationEmailLog {
  id           String         @id @default(uuid()) @db.Uuid
  collegeId    String         @db.Uuid
  invitationId String         @db.Uuid
  studentId    String         @db.Uuid
  toEmail      String
  subject      String
  kind         String
  status       EmailLogStatus @default(QUEUED)
  error        String?
  createdAt    DateTime       @default(now())
  sentAt       DateTime?

  invitation StudentInvitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  student    Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([invitationId, createdAt])
  @@index([collegeId, status])
}

/// An AI-written reading of a student's evidence. The scores in `dimensions` are computed by code from records; the AI only writes
/// `narrative`. A new row is added on every refresh, so earlier readings stay available for comparison.
model StudentIntelligenceReport {
  id            String   @id @default(uuid()) @db.Uuid
  collegeId     String   @db.Uuid
  studentId     String   @db.Uuid
  inputHash     String
  dimensions    Json
  narrative     Json
  model         String
  generatedById String?  @db.Uuid
  createdAt     DateTime @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, createdAt])
  @@index([collegeId])
}

/// One row per sign-in session (the session id comes from the signed token), written by the app after sign-in. Staff, students and recruiters.
model LoginEvent {
  id        String   @id @default(uuid()) @db.Uuid
  collegeId String?  @db.Uuid
  userId    String   @db.Uuid
  kind      String
  sessionId String   @unique
  method    String?
  mfa       Boolean  @default(false)
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([collegeId, createdAt])
}

/// A university a college's programmes are affiliated to. Scoped to one college, like the programmes that point at it.
model University {
  id        String   @id @default(uuid()) @db.Uuid
  collegeId String   @db.Uuid
  name      String
  code      String
  website   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  college  College   @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  programs Program[]

  // Names are also unique ignoring case, through a lower(name) index created in the migration.
  @@unique([collegeId, code])
  @@index([collegeId])
}

/// Extra details for a staff member who has the FACULTY role. Sign-in, status and name stay on User.
model FacultyProfile {
  userId         String    @id @db.Uuid
  collegeId      String    @db.Uuid
  employeeId     String?
  designation    String?
  qualification  String?
  specialisation String?
  phone          String?
  joinedOn       DateTime? @db.Date
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  college College @relation(fields: [collegeId], references: [id], onDelete: Cascade)

  @@unique([collegeId, employeeId])
  @@index([collegeId])
}

/// Which departments a faculty member belongs to.
model FacultyDepartment {
  userId       String @db.Uuid
  departmentId String @db.Uuid
  collegeId    String @db.Uuid

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@id([userId, departmentId])
  @@index([collegeId, departmentId])
}

/// Programmes a faculty member teaches or oversees. Gives access to those programmes' students.
model FacultyProgram {
  userId    String @db.Uuid
  programId String @db.Uuid
  collegeId String @db.Uuid

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  program Program @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@id([userId, programId])
  @@index([collegeId, programId])
}

/// Batches a faculty member is allocated to. Gives access to those batches' students.
model FacultyBatch {
  userId    String @db.Uuid
  batchId   String @db.Uuid
  collegeId String @db.Uuid

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  batch Batch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@id([userId, batchId])
  @@index([collegeId, batchId])
}

/// People who run the platform and can create institutions. They belong to no college and have no User row, so they reach no tenant data.
/// Rows are added only from the command line (npm run db:platform-admin); no API grants this.
model PlatformAdmin {
  id        String   @id @db.Uuid
  email     String   @unique
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

/// Security trail for platform administration (sign-in protection, MFA enrolment / challenges / removal / recovery). Platform admins belong to no
/// college, so this cannot live in AuditLog. No foreign key, so history survives the removal of an administrator.
model PlatformAuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  adminId   String?  @db.Uuid
  email     String?
  action    String
  detail    Json?
  ip        String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([adminId, createdAt])
}

// ---------- Career roadmap (M5) ----------
enum MilestoneStatus {
  PLANNED
  IN_PROGRESS
  DONE
  SKIPPED
}

enum RoadmapGoalStatus {
  OPEN
  ACHIEVED
  DROPPED
}

/// One roadmap per student, built from the programme's own length. The student owns it and may change it; every change is kept in RoadmapEvent.
model StudentRoadmap {
  id              String   @id @default(uuid()) @db.Uuid
  collegeId       String   @db.Uuid
  studentId       String   @unique @db.Uuid
  /// Semesters in the student's programme when the roadmap was made.
  totalSemesters  Int
  targetRole      String?
  careerGoal      String?
  templateVersion String   @default("1")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  student    Student            @relation(fields: [studentId], references: [id], onDelete: Cascade)
  milestones RoadmapMilestone[]
  goals      RoadmapGoal[]
  comments   RoadmapComment[]
  events     RoadmapEvent[]

  @@index([collegeId])
}

model RoadmapMilestone {
  id          String          @id @default(uuid()) @db.Uuid
  roadmapId   String          @db.Uuid
  collegeId   String          @db.Uuid
  /// Library key for template milestones ("d-profile"), "rec:..." for accepted recommendations, null for the student's own.
  key         String?
  semester    Int
  phase       String
  category    String
  title       String
  description String?
  /// Name of the rule that ticks it automatically from system data, if any.
  auto        String?
  status      MilestoneStatus @default(PLANNED)
  /// TEMPLATE, RECOMMENDED or CUSTOM.
  source      String          @default("TEMPLATE")
  completedAt DateTime?
  /// AUTO, STUDENT or MENTOR.
  completedBy String?
  note        String?
  sortOrder   Int             @default(0)
  /// A removed milestone is archived, not deleted, so the history stays complete.
  archivedAt  DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  roadmap StudentRoadmap @relation(fields: [roadmapId], references: [id], onDelete: Cascade)

  @@index([roadmapId, semester])
  @@index([collegeId, status])
}

model RoadmapGoal {
  id          String            @id @default(uuid()) @db.Uuid
  roadmapId   String            @db.Uuid
  collegeId   String            @db.Uuid
  title       String
  description String?
  targetDate  DateTime?         @db.Date
  status      RoadmapGoalStatus @default(OPEN)
  achievedAt  DateTime?
  createdAt   DateTime          @default(now())

  roadmap StudentRoadmap @relation(fields: [roadmapId], references: [id], onDelete: Cascade)

  @@index([roadmapId])
}

/// A note from a mentor or staff member to the student, shown on the roadmap.
model RoadmapComment {
  id         String   @id @default(uuid()) @db.Uuid
  roadmapId  String   @db.Uuid
  collegeId  String   @db.Uuid
  authorId   String   @db.Uuid
  authorName String
  /// MENTOR or STAFF.
  authorRole String
  body       String
  createdAt  DateTime @default(now())

  roadmap StudentRoadmap @relation(fields: [roadmapId], references: [id], onDelete: Cascade)

  @@index([roadmapId, createdAt])
}

/// Every change to a roadmap: who did it, what, and when.
model RoadmapEvent {
  id        String   @id @default(uuid()) @db.Uuid
  roadmapId String   @db.Uuid
  collegeId String   @db.Uuid
  /// STUDENT, MENTOR, STAFF or SYSTEM.
  actor     String
  actorId   String?  @db.Uuid
  action    String
  detail    Json     @default("{}")
  createdAt DateTime @default(now())

  roadmap StudentRoadmap @relation(fields: [roadmapId], references: [id], onDelete: Cascade)

  @@index([roadmapId, createdAt])
}

// ---------- Learning management: courses (M6) ----------
enum CourseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum LessonType {
  VIDEO
  DOCUMENT
  LINK
  TEXT
  ASSIGNMENT
  QUIZ
  LIVE
}

enum EnrolmentStatus {
  ENROLLED
  COMPLETED
  WITHDRAWN
}

enum SubmissionStatus {
  SUBMITTED
  GRADED
  RETURNED
}

/// A course made by staff: modules, then lessons (chapters). Students browse published courses and enrol, or staff enrol a group.
model Course {
  id                 String       @id @default(uuid()) @db.Uuid
  collegeId          String       @db.Uuid
  title              String
  summary            String?
  description        String?
  category           String?
  level              String?
  skills             String[]
  /// Who may see and join it. Empty means every student of the college.
  departmentId       String?      @db.Uuid
  batchId            String?      @db.Uuid
  status             CourseStatus @default(DRAFT)
  certificateEnabled Boolean      @default(true)
  /// When false only staff can enrol students.
  selfEnrol          Boolean      @default(true)
  createdById        String       @db.Uuid
  publishedAt        DateTime?
  archivedAt         DateTime?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  modules      CourseModule[]
  lessons      CourseLesson[]
  enrolments   CourseEnrolment[]
  certificates CourseCertificate[]

  @@index([collegeId, status])
}

model CourseModule {
  id        String @id @default(uuid()) @db.Uuid
  courseId  String @db.Uuid
  title     String
  sortOrder Int    @default(0)

  course  Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons CourseLesson[]

  @@index([courseId])
}

/// One chapter. What it needs depends on its type: VIDEO and DOCUMENT use a link or an uploaded file, TEXT uses body, ASSIGNMENT uses body/dueAt/maxMarks,
/// QUIZ uses questions/passPercent/maxAttempts, LIVE uses url (meeting link), startsAt and durationMin.
model CourseLesson {
  id           String     @id @default(uuid()) @db.Uuid
  courseId     String     @db.Uuid
  moduleId     String     @db.Uuid
  collegeId    String     @db.Uuid
  type         LessonType
  title        String
  body         String?
  url          String?
  filePath     String?
  fileName     String?
  mimeType     String?
  sizeBytes    Int?
  downloadable Boolean    @default(false)
  /// Counts towards finishing the course.
  required     Boolean    @default(true)
  sortOrder    Int        @default(0)
  maxMarks     Int?
  dueAt        DateTime?
  startsAt     DateTime?
  durationMin  Int?
  passPercent  Int?
  maxAttempts  Int?
  questions    Json?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  course      Course                 @relation(fields: [courseId], references: [id], onDelete: Cascade)
  module      CourseModule           @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  progress    LessonProgress[]
  attempts    QuizAttempt[]
  submissions AssignmentSubmission[]
  doubts      CourseQuestion[]

  @@index([courseId])
  @@index([moduleId])
}

model CourseEnrolment {
  id             String          @id @default(uuid()) @db.Uuid
  courseId       String          @db.Uuid
  studentId      String          @db.Uuid
  collegeId      String          @db.Uuid
  status         EnrolmentStatus @default(ENROLLED)
  /// The staff user who enrolled the student, or null when the student joined on their own.
  enrolledById   String?         @db.Uuid
  enrolledAt     DateTime        @default(now())
  completedAt    DateTime?
  lastActivityAt DateTime        @default(now())

  course      Course                 @relation(fields: [courseId], references: [id], onDelete: Cascade)
  student     Student                @relation(fields: [studentId], references: [id], onDelete: Cascade)
  progress    LessonProgress[]
  attempts    QuizAttempt[]
  submissions AssignmentSubmission[]
  doubts      CourseQuestion[]
  certificate CourseCertificate?

  @@unique([courseId, studentId])
  @@index([studentId])
  @@index([collegeId])
}

model LessonProgress {
  id          String   @id @default(uuid()) @db.Uuid
  enrolmentId String   @db.Uuid
  lessonId    String   @db.Uuid
  completedAt DateTime @default(now())

  enrolment CourseEnrolment @relation(fields: [enrolmentId], references: [id], onDelete: Cascade)
  lesson    CourseLesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([enrolmentId, lessonId])
  @@index([lessonId])
}

model QuizAttempt {
  id            String   @id @default(uuid()) @db.Uuid
  lessonId      String   @db.Uuid
  enrolmentId   String   @db.Uuid
  studentId     String   @db.Uuid
  attemptNumber Int
  /// The chosen option per question (null = skipped).
  answers       Json
  score         Int
  total         Int
  percent       Int
  passed        Boolean
  createdAt     DateTime @default(now())

  lesson    CourseLesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  enrolment CourseEnrolment @relation(fields: [enrolmentId], references: [id], onDelete: Cascade)

  @@unique([lessonId, enrolmentId, attemptNumber])
  @@index([studentId])
}

model AssignmentSubmission {
  id          String           @id @default(uuid()) @db.Uuid
  lessonId    String           @db.Uuid
  enrolmentId String           @db.Uuid
  studentId   String           @db.Uuid
  text        String?
  filePath    String?
  fileName    String?
  mimeType    String?
  status      SubmissionStatus @default(SUBMITTED)
  marks       Int?
  feedback    String?
  gradedById  String?          @db.Uuid
  gradedAt    DateTime?
  submittedAt DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  lesson    CourseLesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  enrolment CourseEnrolment @relation(fields: [enrolmentId], references: [id], onDelete: Cascade)

  @@unique([lessonId, enrolmentId])
  @@index([studentId])
}

/// A student's question about a course or one lesson, answered by staff.
model CourseQuestion {
  id           String    @id @default(uuid()) @db.Uuid
  courseId     String    @db.Uuid
  lessonId     String?   @db.Uuid
  enrolmentId  String    @db.Uuid
  studentId    String    @db.Uuid
  collegeId    String    @db.Uuid
  question     String
  answer       String?
  answeredById String?   @db.Uuid
  answeredAt   DateTime?
  createdAt    DateTime  @default(now())

  lesson    CourseLesson?   @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  enrolment CourseEnrolment @relation(fields: [enrolmentId], references: [id], onDelete: Cascade)

  @@index([courseId, answeredAt])
  @@index([studentId])
}

model CourseCertificate {
  id          String   @id @default(uuid()) @db.Uuid
  courseId    String   @db.Uuid
  enrolmentId String   @unique @db.Uuid
  studentId   String   @db.Uuid
  collegeId   String   @db.Uuid
  serial      String   @unique
  issuedAt    DateTime @default(now())

  course    Course          @relation(fields: [courseId], references: [id], onDelete: Cascade)
  enrolment CourseEnrolment @relation(fields: [enrolmentId], references: [id], onDelete: Cascade)

  @@index([studentId])
}

// ---------- Projects and portfolio (M8) ----------
enum ProjectType {
  INDIVIDUAL
  TEAM
  INTERDISCIPLINARY
}

/// PROPOSED: a student's own idea waiting for approval. OPEN: students can take it. CLOSED: no new teams. REJECTED: a proposal that was turned down.
enum ProjectStatus {
  PROPOSED
  DRAFT
  OPEN
  CLOSED
  ARCHIVED
  REJECTED
}

enum TeamStatus {
  FORMING
  ACTIVE
  SUBMITTED
  EVALUATED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum ReviewerType {
  FACULTY
  INDUSTRY
  STAFF
}

enum ProjectFileKind {
  DOCUMENT
  PRESENTATION
}

/// A problem statement in the college's project repository. Teams (one student for an individual project) take it up and do the work.
model Project {
  id                String        @id @default(uuid()) @db.Uuid
  collegeId         String        @db.Uuid
  title             String
  problemStatement  String
  skills            String[]
  type              ProjectType   @default(TEAM)
  status            ProjectStatus @default(DRAFT)
  minTeamSize       Int           @default(1)
  maxTeamSize       Int           @default(1)
  /// Who may take it. Empty means every department / batch.
  departmentIds     String[]      @db.Uuid
  batchIds          String[]      @db.Uuid
  /// The faculty member who guides and reviews it.
  guideId           String?       @db.Uuid
  industryPartner   String?
  startsAt          DateTime?
  dueAt             DateTime?
  /// When true students may start or join teams themselves; otherwise staff allocate.
  selfFormTeams     Boolean       @default(true)
  maxTeams          Int?
  /// Milestones every team gets: [{ title, dueInDays }], counted from the team's start.
  milestoneTemplate Json          @default("[]")
  proposedById      String?       @db.Uuid
  createdById       String?       @db.Uuid
  rejectReason      String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @default(now()) @updatedAt

  teams   ProjectTeam[]
  members ProjectMember[]

  @@index([collegeId, status])
}

model ProjectTeam {
  id                String     @id @default(uuid()) @db.Uuid
  projectId         String     @db.Uuid
  collegeId         String     @db.Uuid
  name              String
  leaderId          String     @db.Uuid
  status            TeamStatus @default(FORMING)
  summary           String?
  repoUrl           String?
  /// Commit figures read from GitHub: { fullName, pushedAt, totalCommits, contributors: [{ login, commits }], fetchedAt }.
  repoStats         Json?
  repoSyncedAt      DateTime?
  startedAt         DateTime?
  submittedAt       DateTime?
  /// The published result, as a percentage. Students see it only once resultPublishedAt is set.
  finalPercent      Int?
  resultPublishedAt DateTime?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @default(now()) @updatedAt

  project    Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  members    ProjectMember[]
  milestones ProjectMilestone[]
  tasks      ProjectTask[]
  updates    ProjectUpdate[]
  files      ProjectFile[]
  reviews    ProjectReview[]
  invites    ProjectMentorInvite[]

  @@index([projectId])
  @@index([collegeId])
}

model ProjectMember {
  id              String   @id @default(uuid()) @db.Uuid
  teamId          String   @db.Uuid
  projectId       String   @db.Uuid
  studentId       String   @db.Uuid
  collegeId       String   @db.Uuid
  /// Stated by the student; used to match commits to people. Not verified.
  githubUsername  String?
  role            String?
  showInPortfolio Boolean  @default(true)
  joinedAt        DateTime @default(now())

  team    ProjectTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)
  project Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  student Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([projectId, studentId])
  @@index([studentId])
  @@index([teamId])
}

model ProjectMilestone {
  id        String    @id @default(uuid()) @db.Uuid
  teamId    String    @db.Uuid
  title     String
  dueAt     DateTime?
  sortOrder Int       @default(0)
  doneAt    DateTime?

  team  ProjectTeam   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  tasks ProjectTask[]

  @@index([teamId])
}

model ProjectTask {
  id                 String     @id @default(uuid()) @db.Uuid
  teamId             String     @db.Uuid
  milestoneId        String?    @db.Uuid
  title              String
  description        String?
  assigneeId         String?    @db.Uuid
  status             TaskStatus @default(TODO)
  dueAt              DateTime?
  completedAt        DateTime?
  createdByStudentId String?    @db.Uuid
  createdByUserId    String?    @db.Uuid
  createdAt          DateTime   @default(now())

  team      ProjectTeam       @relation(fields: [teamId], references: [id], onDelete: Cascade)
  milestone ProjectMilestone? @relation(fields: [milestoneId], references: [id], onDelete: SetNull)

  @@index([teamId])
}

/// A progress update from a student, or a note from a faculty member or staff.
model ProjectUpdate {
  id           String   @id @default(uuid()) @db.Uuid
  teamId       String   @db.Uuid
  studentId    String?  @db.Uuid
  authorUserId String?  @db.Uuid
  text         String
  createdAt    DateTime @default(now())

  team ProjectTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId, createdAt])
}

model ProjectFile {
  id                  String          @id @default(uuid()) @db.Uuid
  teamId              String          @db.Uuid
  kind                ProjectFileKind
  title               String
  filePath            String
  fileName            String
  mimeType            String
  sizeBytes           Int
  uploadedByStudentId String?         @db.Uuid
  createdAt           DateTime        @default(now())

  team ProjectTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId])
}

/// One review of a team by a faculty guide, staff member or an industry mentor. `scores` has a 0-10 mark per rubric criterion; `individualMarks` optionally
/// marks single students (0-10) so one person's contribution can differ from the team's result.
model ProjectReview {
  id              String       @id @default(uuid()) @db.Uuid
  teamId          String       @db.Uuid
  reviewerType    ReviewerType
  reviewerName    String
  reviewerUserId  String?      @db.Uuid
  inviteId        String?      @db.Uuid
  comments        String?
  scores          Json
  individualMarks Json         @default("{}")
  percent         Int
  isFinal         Boolean      @default(false)
  createdAt       DateTime     @default(now())

  team ProjectTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId])
}

/// A one-time link that lets an industry mentor (who has no account) review one team.
model ProjectMentorInvite {
  id          String    @id @default(uuid()) @db.Uuid
  teamId      String    @db.Uuid
  collegeId   String    @db.Uuid
  name        String
  email       String
  tokenHash   String    @unique
  expiresAt   DateTime
  usedAt      DateTime?
  createdById String    @db.Uuid
  createdAt   DateTime  @default(now())

  team ProjectTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId])
}

// ---------- Internship management (M9) ----------
enum InternshipMode {
  ONSITE
  REMOTE
  HYBRID
}

enum PostingStatus {
  DRAFT
  OPEN
  CLOSED
  CANCELLED
}

enum InternshipApplicationStatus {
  APPLIED
  COLLEGE_APPROVED
  COLLEGE_REJECTED
  COMPANY_SELECTED
  COMPANY_REJECTED
  WITHDRAWN
  ALLOTTED
}

enum AttendanceMark {
  PRESENT
  ABSENT
  LEAVE
}

enum InternshipTaskStatus {
  ASSIGNED
  SUBMITTED
  APPROVED
  CHANGES_REQUESTED
}

enum CertificateStatus {
  NONE
  PENDING
  VERIFIED
  REJECTED
}

enum PpoStatus {
  NONE
  EXPECTED
  OFFERED
  ACCEPTED
  DECLINED
}

/// An internship a company offers through the college. Staff post it once the company has confirmed it.
model InternshipPosting {
  id                   String         @id @default(uuid()) @db.Uuid
  collegeId            String         @db.Uuid
  companyId            String?        @db.Uuid
  companyName          String
  title                String
  description          String?
  location             String?
  mode                 InternshipMode @default(ONSITE)
  stipendInr           Int?
  openings             Int?
  skills               String[]
  startDate            DateTime       @db.Date
  endDate              DateTime       @db.Date
  applicationDeadline  DateTime
  /// Whether the company has confirmed the internship; a posting cannot open without it.
  companyConfirmed     Boolean        @default(false)
  companyConfirmedNote String?
  minCgpa              Decimal?       @db.Decimal(4, 2)
  minTenthPct          Decimal?       @db.Decimal(5, 2)
  minTwelfthPct        Decimal?       @db.Decimal(5, 2)
  maxActiveBacklogs    Int?
  departmentIds        String[]       @db.Uuid
  batchIds             String[]       @db.Uuid
  programIds           String[]       @db.Uuid
  allowPlaced          Boolean        @default(true)
  status               PostingStatus  @default(DRAFT)
  createdById          String         @db.Uuid
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @default(now()) @updatedAt

  applications InternshipApplication[]

  @@index([collegeId, status])
}

/// A student's application to a posting, or an internship they found themselves that needs the college's approval.
model InternshipApplication {
  id                 String                      @id @default(uuid()) @db.Uuid
  collegeId          String                      @db.Uuid
  studentId          String                      @db.Uuid
  postingId          String?                     @db.Uuid
  selfSourced        Boolean                     @default(false)
  companyName        String?
  role               String?
  startDate          DateTime?                   @db.Date
  endDate            DateTime?                   @db.Date
  mentorName         String?
  mentorEmail        String?
  offerLetterPath    String?
  offerLetterName    String?
  note               String?
  status             InternshipApplicationStatus @default(APPLIED)
  /// Why the student did not meet the rules when they applied (staff may still approve).
  eligibilityGaps    String[]
  collegeDecidedById String?                     @db.Uuid
  collegeDecidedAt   DateTime?
  collegeNote        String?
  companyDecidedAt   DateTime?
  companyNote        String?
  createdAt          DateTime                    @default(now())
  updatedAt          DateTime                    @default(now()) @updatedAt

  posting InternshipPosting? @relation(fields: [postingId], references: [id], onDelete: SetNull)
  student Student            @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([postingId, studentId])
  @@index([collegeId, status])
  @@index([studentId])
}

/// A student's attendance for one working day. The student marks it; a mentor or staff verify or correct it.
model InternshipAttendance {
  id           String         @id @default(uuid()) @db.Uuid
  internshipId String         @db.Uuid
  date         DateTime       @db.Date
  status       AttendanceMark
  note         String?
  markedBy     String         @default("STUDENT")
  verified     Boolean        @default(false)
  verifiedById String?        @db.Uuid
  updatedAt    DateTime       @default(now()) @updatedAt

  internship Internship @relation(fields: [internshipId], references: [id], onDelete: Cascade)

  @@unique([internshipId, date])
}

/// Work given to the intern, handed in by them and reviewed. `isFinalReport` marks the closing report.
model InternshipTask {
  id               String               @id @default(uuid()) @db.Uuid
  internshipId     String               @db.Uuid
  title            String
  description      String?
  dueAt            DateTime?
  isFinalReport    Boolean              @default(false)
  status           InternshipTaskStatus @default(ASSIGNED)
  assignedByName   String
  assignedByUserId String?              @db.Uuid
  submissionText   String?
  submissionUrl    String?
  filePath         String?
  fileName         String?
  fileMime         String?
  submittedAt      DateTime?
  reviewComment    String?
  reviewedByName   String?
  reviewedAt       DateTime?
  createdAt        DateTime             @default(now())

  internship Internship @relation(fields: [internshipId], references: [id], onDelete: Cascade)

  @@index([internshipId])
}

/// Mentor feedback: from the faculty mentor, staff or the company's mentor (through a link).
model InternshipFeedback {
  id           String       @id @default(uuid()) @db.Uuid
  internshipId String       @db.Uuid
  authorType   ReviewerType
  authorName   String
  authorUserId String?      @db.Uuid
  text         String
  createdAt    DateTime     @default(now())

  internship Internship @relation(fields: [internshipId], references: [id], onDelete: Cascade)

  @@index([internshipId, createdAt])
}

/// A one-time link that lets the company's mentor, who has no account, give an evaluation and feedback.
model InternshipMentorLink {
  id           String    @id @default(uuid()) @db.Uuid
  internshipId String    @db.Uuid
  collegeId    String    @db.Uuid
  name         String
  email        String
  tokenHash    String    @unique
  expiresAt    DateTime
  usedAt       DateTime?
  createdById  String    @db.Uuid
  createdAt    DateTime  @default(now())

  internship Internship @relation(fields: [internshipId], references: [id], onDelete: Cascade)

  @@index([internshipId])
}

// ---------- Dynamic resume engine (M10) ----------
enum ResumeKind {
  MASTER
  TECHNICAL
  MANAGEMENT
  INTERNSHIP
  FRESHER
  PROJECT_BASED
  COMPANY_SPECIFIC
}

enum ResumeStatus {
  DRAFT
  APPROVED
  ARCHIVED
}

/// One resume a student made from their master profile. A draft is rebuilt from the live profile each time it is opened; approving it freezes `doc`.
/// An approved version never changes: editing it makes a new draft, so the history of what was sent stays true.
model ResumeVersion {
  id            String       @id @default(uuid()) @db.Uuid
  collegeId     String       @db.Uuid
  studentId     String       @db.Uuid
  number        Int
  title         String
  kind          ResumeKind   @default(MASTER)
  template      String       @default("ATS")
  targetCompany String?
  targetRole    String?
  targetText    String?
  /// What the student changed by hand: { summary, headline, hide: [keys], text: { key: text } }.
  edits         Json         @default("{}")
  /// Only checked material (true) or everything the student entered (false).
  verifiedOnly  Boolean      @default(false)
  markEvidence  Boolean      @default(true)
  status        ResumeStatus @default(DRAFT)
  /// The finished document, kept when the version is approved.
  doc           Json?
  /// Keys of the profile items the document was made from, to tell later what is new.
  profileKeys   String[]
  approvedAt    DateTime?
  isPrimary     Boolean      @default(false)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @default(now()) @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, number])
  @@index([studentId, status])
  @@index([collegeId])
}

// ---------- Job description management (M11) ----------
enum JdStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  ARCHIVED
}

enum JdSource {
  UPLOAD
  PASTE
  MANUAL
}

/// A job description as structured, reviewed data. `data` holds the title, requirements (each mandatory or preferred, weighted), eligibility rules, selection process and
/// scoring weights (see lib/jd.ts). Nothing built from it (a drive, the matching engine) may use it before it is APPROVED by an authorised person.
model JobDescription {
  id              String    @id @default(uuid()) @db.Uuid
  collegeId       String    @db.Uuid
  driveId         String?   @unique @db.Uuid
  companyId       String?   @db.Uuid
  source          JdSource
  status          JdStatus  @default(DRAFT)
  /// Copied out of `data` for lists and search.
  title           String
  companyName     String
  rawText         String?
  fileName        String?
  filePath        String?
  mimeType        String?
  sizeBytes       Int?
  data            Json
  /// Things the extraction could not be sure about, shown to the reviewer.
  extractionNotes String[]
  extractedAt     DateTime?
  reviewNote      String?
  submittedAt     DateTime?
  approvedById    String?   @db.Uuid
  approvedAt      DateTime?
  createdById     String    @db.Uuid
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @default(now()) @updatedAt

  drive     Drive?         @relation(fields: [driveId], references: [id], onDelete: SetNull)
  shortlist JdShortlist[]
  campaigns PrepCampaign[]

  @@index([collegeId, status])
}

/// A student a person chose from the match ranking for a job description. The score and the evidence at that moment are kept, so the decision can be explained later.
/// This only invites and records; the final selection stays with the drive's rounds and the people who run them.
model JdShortlist {
  id              String   @id @default(uuid()) @db.Uuid
  collegeId       String   @db.Uuid
  jdId            String   @db.Uuid
  studentId       String   @db.Uuid
  score           Int
  mandatoryStatus String
  /// The weights, parameter scores, skills and explanation as they were when the person shortlisted the student.
  snapshot        Json
  note            String?
  decidedById     String   @db.Uuid
  createdAt       DateTime @default(now())

  jd      JobDescription @relation(fields: [jdId], references: [id], onDelete: Cascade)
  student Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([jdId, studentId])
  @@index([studentId])
}

// ---------- Job-specific preparation campaigns (M13) ----------
enum CampaignStatus {
  DRAFT
  ACTIVE
  COMPLETED
  CANCELLED
}

enum CampaignMemberStatus {
  SELECTED
  INVITED
  ACCEPTED
  DECLINED
  REMOVED
}

enum PlanItemKind {
  LEARN
  COURSE
  RESOURCE
  PRACTICE
  MOCK_TEST
  MOCK_INTERVIEW
  REVISION
}

enum PlanItemStatus {
  PENDING
  DONE
  SKIPPED
}

/// A preparation drive for one job: chosen candidates, a personal day-by-day plan for each, trainers, mock tests and interviews, and progress tracking.
/// `config` holds { mockTests: [{ scheduleId, title, date, kind }], mockInterviews: [{ title, date, kind }], resourceIds: [], milestones: [{ title, dueAt }], notify: { email, remindBehind } }.
model PrepCampaign {
  id          String         @id @default(uuid()) @db.Uuid
  collegeId   String         @db.Uuid
  jdId        String         @db.Uuid
  driveId     String?        @db.Uuid
  name        String
  company     String
  jobRole     String
  description String?
  ownerId     String         @db.Uuid
  status      CampaignStatus @default(DRAFT)
  startsAt    DateTime       @db.Date
  deadline    DateTime       @db.Date
  trainerIds  String[]       @db.Uuid
  config      Json           @default("{}")
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @default(now()) @updatedAt

  jd      JobDescription     @relation(fields: [jdId], references: [id])
  groups  CampaignGroup[]
  members CampaignMember[]
  events  CampaignEvent[]
  items   CampaignPlanItem[]

  @@index([collegeId, status])
  @@index([jdId])
}

model CampaignGroup {
  id         String  @id @default(uuid()) @db.Uuid
  campaignId String  @db.Uuid
  name       String
  trainerId  String? @db.Uuid
  sortOrder  Int     @default(0)

  campaign PrepCampaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  members  CampaignMember[]

  @@index([campaignId])
}

model CampaignMember {
  id              String               @id @default(uuid()) @db.Uuid
  campaignId      String               @db.Uuid
  studentId       String               @db.Uuid
  groupId         String?              @db.Uuid
  status          CampaignMemberStatus @default(SELECTED)
  addedManually   Boolean              @default(false)
  scoreAtAdd      Int?
  /// The skill gap report as it was when the student was invited: score, skills matched, partly matched and missing, and the explanation.
  gapReport       Json?
  invitedAt       DateTime?
  respondedAt     DateTime?
  declineReason   String?
  startedAt       DateTime?
  helpNote        String?
  helpRequestedAt DateTime?
  helpResponse    String?
  helpRespondedAt DateTime?
  readyMarkedAt   DateTime?
  readyMarkedById String?              @db.Uuid
  createdAt       DateTime             @default(now())

  campaign PrepCampaign       @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  group    CampaignGroup?     @relation(fields: [groupId], references: [id], onDelete: SetNull)
  student  Student            @relation(fields: [studentId], references: [id], onDelete: Cascade)
  items    CampaignPlanItem[]

  @@unique([campaignId, studentId])
  @@index([studentId])
}

/// One thing a student is to do on a given day. Items tied to a course, study material, mock test or mock interview tick themselves when the student finishes it there.
model CampaignPlanItem {
  id         String         @id @default(uuid()) @db.Uuid
  campaignId String         @db.Uuid
  memberId   String         @db.Uuid
  day        Int
  dueAt      DateTime
  kind       PlanItemKind
  title      String
  detail     String?
  skill      String?
  refType    String?
  refId      String?        @db.Uuid
  optional   Boolean        @default(false)
  status     PlanItemStatus @default(PENDING)
  doneAt     DateTime?
  autoDone   Boolean        @default(false)
  /// PLANNER (made by the rules), STAFF (added or changed by a person) or STUDENT.
  source     String         @default("PLANNER")
  createdAt  DateTime       @default(now())

  campaign PrepCampaign   @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  member   CampaignMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId, dueAt])
  @@index([campaignId])
}

/// Everything that changes in a campaign, with who did it.
model CampaignEvent {
  id         String   @id @default(uuid()) @db.Uuid
  campaignId String   @db.Uuid
  memberId   String?  @db.Uuid
  actorType  String
  actorId    String?  @db.Uuid
  action     String
  detail     Json     @default("{}")
  createdAt  DateTime @default(now())

  campaign PrepCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId, createdAt])
}

// ---------- Mock test engine (M14) ----------
/// What the improvement engine made for a student after one attempt: weak topics, study material, the targeted practice set, and when to reassess.
model TestImprovement {
  id                 String   @id @default(uuid()) @db.Uuid
  collegeId          String   @db.Uuid
  studentId          String   @db.Uuid
  attemptId          String   @unique @db.Uuid
  weakTopics         Json
  recommendations    Json
  practiceScheduleId String?  @db.Uuid
  reassessAt         DateTime @db.Date
  createdAt          DateTime @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
}

/// A saved readiness score, at most one per student, measure and day, so progress can be shown over time. `scopeKey` is "career" for the Career Readiness Index or the job description id for a Job-Specific Readiness Score.
model ReadinessSnapshot {
  id         String   @id @default(uuid()) @db.Uuid
  collegeId  String   @db.Uuid
  studentId  String   @db.Uuid
  kind       String
  jdId       String?  @db.Uuid
  scopeKey   String
  day        DateTime @db.Date
  score      Int
  coverage   Int
  /// Each part's value (0 to 1) or null when it could not be measured.
  components Json
  createdAt  DateTime @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, scopeKey, day])
  @@index([collegeId, scopeKey])
}

/// A practice group discussion, debate or presentation with AI participants. Self-started ones are private; ones from an assignment are visible to staff.
model DiscussionSession {
  id                String    @id @default(uuid()) @db.Uuid
  collegeId         String    @db.Uuid
  studentId         String    @db.Uuid
  /// GD, DEBATE or PRESENTATION.
  kind              String
  topic             String
  /// FOR or AGAINST in a debate, otherwise null.
  stance            String?
  difficulty        String    @default("MEDIUM")
  language          String    @default("English")
  durationMin       Int       @default(10)
  /// How many contributions the student is expected to make.
  contributionCount Int       @default(4)
  /// The AI participants and how each takes part: [{ name, style }].
  participants      Json
  status            String    @default("IN_PROGRESS")
  transcript        Json      @default("[]")
  feedback          Json?
  assignmentId      String?   @db.Uuid
  voiceConsentAt    DateTime?
  voiceUsed         Boolean   @default(false)
  createdAt         DateTime  @default(now())
  completedAt       DateTime?

  student    Student               @relation(fields: [studentId], references: [id], onDelete: Cascade)
  assignment DiscussionAssignment? @relation(fields: [assignmentId], references: [id], onDelete: SetNull)

  @@index([studentId, createdAt])
  @@index([assignmentId])
}

/// A discussion the placement office sets up for a group of students. Its sessions and reports are visible to staff, and the student is told so before starting.
model DiscussionAssignment {
  id                  String    @id @default(uuid()) @db.Uuid
  collegeId           String    @db.Uuid
  title               String
  kind                String
  topic               String
  difficulty          String    @default("MEDIUM")
  language            String    @default("English")
  durationMin         Int       @default(10)
  dueAt               DateTime?
  targetDepartmentIds String[]
  targetBatchIds      String[]
  createdById         String    @db.Uuid
  createdAt           DateTime  @default(now())

  sessions DiscussionSession[]

  @@index([collegeId, createdAt])
}

/// One person's choice for one kind of notification on one channel. `ownerKey` is "S:<studentId>" or "U:<userId>". No row means the default applies. For SMS and WhatsApp a row with enabled = true is the person's consent, and `updatedAt` is when they gave it.
model NotificationPref {
  id        String   @id @default(uuid()) @db.Uuid
  collegeId String   @db.Uuid
  ownerKey  String
  studentId String?  @db.Uuid
  userId    String?  @db.Uuid
  category  String
  channel   String
  enabled   Boolean
  updatedAt DateTime @updatedAt

  student Student? @relation(fields: [studentId], references: [id], onDelete: Cascade)
  user    User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([ownerKey, category, channel])
  @@index([collegeId])
}

/// Every attempt to send a notification outside the app (email, SMS, WhatsApp), and the ones skipped with the reason, so staff can see what happened.
model NotificationDelivery {
  id             String   @id @default(uuid()) @db.Uuid
  collegeId      String   @db.Uuid
  studentId      String   @db.Uuid
  /// The in-app notification this delivery is for, when there is one. One delivery per notification and channel.
  notificationId String?  @db.Uuid
  channel        String
  category       String
  /// SENT, FAILED or SKIPPED.
  status         String
  detail         String?
  providerRef    String?
  title          String
  createdAt      DateTime @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([notificationId, channel])
  @@index([collegeId, createdAt])
  @@index([studentId, createdAt])
}

/// A private calendar subscription link for a student. Only a hash of the secret is kept, so the link can be shown once and then only replaced.
model CalendarFeed {
  id         String    @id @default(uuid()) @db.Uuid
  collegeId  String    @db.Uuid
  studentId  String    @unique @db.Uuid
  tokenHash  String    @unique
  createdAt  DateTime  @default(now())
  rotatedAt  DateTime?
  lastReadAt DateTime?

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

// ---- Super Admin Control Centre (Batch 4). Platform-level records: none holds student or staff data; institution links are plain ids with no foreign key.

enum SupportPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum IncidentSeverity {
  MINOR
  MAJOR
  CRITICAL
}

enum IncidentStatus {
  INVESTIGATING
  IDENTIFIED
  MONITORING
  RESOLVED
}

/// A platform-wide incident (an outage or degradation). Recorded by a platform administrator; nothing is detected or created automatically.
model PlatformIncident {
  id               String           @id @default(uuid()) @db.Uuid
  title            String
  severity         IncidentSeverity
  status           IncidentStatus   @default(INVESTIGATING)
  startedAt        DateTime         @default(now())
  resolvedAt       DateTime?
  createdByAdminId String?          @db.Uuid
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  updates PlatformIncidentUpdate[]

  @@index([status, startedAt])
}

model PlatformIncidentUpdate {
  id         String         @id @default(uuid()) @db.Uuid
  incidentId String         @db.Uuid
  status     IncidentStatus
  message    String
  adminId    String?        @db.Uuid
  createdAt  DateTime       @default(now())

  incident PlatformIncident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@index([incidentId, createdAt])
}

enum AnnouncementKind {
  MAINTENANCE
  FEATURE
  OUTAGE
}

/// A notice from the platform to institutions. publishedAt null means draft. Shown inside the application only: nothing is emailed, texted or sent over WhatsApp.
model PlatformAnnouncement {
  id               String           @id @default(uuid()) @db.Uuid
  kind             AnnouncementKind
  title            String
  body             String
  allInstitutions  Boolean          @default(true)
  startsAt         DateTime
  endsAt           DateTime?
  publishedAt      DateTime?
  cancelledAt      DateTime?
  createdByAdminId String?          @db.Uuid
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  targets PlatformAnnouncementTarget[]
  acks    PlatformAnnouncementAck[]

  @@index([publishedAt, startsAt])
}

/// The institutions a non-global announcement is for. collegeId is a plain id (no foreign key) so this table never constrains an institution.
model PlatformAnnouncementTarget {
  announcementId String @db.Uuid
  collegeId      String @db.Uuid

  announcement PlatformAnnouncement @relation(fields: [announcementId], references: [id], onDelete: Cascade)

  @@id([announcementId, collegeId])
  @@index([collegeId])
}

/// An institution administrator confirming they have read an announcement.
model PlatformAnnouncementAck {
  announcementId String   @db.Uuid
  collegeId      String   @db.Uuid
  userId         String   @db.Uuid
  ackedAt        DateTime @default(now())

  announcement PlatformAnnouncement @relation(fields: [announcementId], references: [id], onDelete: Cascade)

  @@id([announcementId, userId])
  @@index([collegeId])
}

/// A platform-wide emergency switch for one module. An absent row means "on". It can only ever REDUCE access: an institution still needs the module switched on for itself.
model PlatformModuleSetting {
  module          ModuleKey @id
  globallyEnabled Boolean   @default(true)
  reason          String?
  /// The module is not available to anyone before this time (scheduled launch). Null means no schedule.
  availableFrom   DateTime?
  /// Gradual rollout: the share of institutions (0 to 100) the module is available to. Which institutions is decided by a stable hash, so it never flips between requests.
  rolloutPercent  Int       @default(100)
  updatedAt       DateTime  @updatedAt
  updatedBy       String?   @db.Uuid
}

enum SecurityReviewStatus {
  UNDER_REVIEW
  RESOLVED
  NO_ACTION
}

/// A platform administrator's review of one recorded security event. An event with no row here has not been reviewed. Nothing is called an attack: the status says what was done about it.
model PlatformSecurityReview {
  id                 String               @id @default(uuid()) @db.Uuid
  source             String
  eventId            String               @db.Uuid
  status             SecurityReviewStatus
  note               String?
  reviewedByAdminId  String?              @db.Uuid
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  @@unique([source, eventId])
  @@index([status, updatedAt])
}

/// One recorded refusal of a signed-in person's request (a role or module the person is not allowed). Counts and a route pattern only: no person, no request content.
/// collegeId is a plain id (no foreign key). This is NOT a record of sign-in failures, which happen inside the Auth service, nor of attempts that end in "not found".
model PlatformAccessDenial {
  id        String   @id @default(uuid()) @db.Uuid
  collegeId String?  @db.Uuid
  role      String?
  kind      String
  route     String
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([collegeId, createdAt])
}
