model ReassessmentRule {
  id           String             @id @default(uuid()) @db.Uuid
  collegeId    String             @db.Uuid
  category     AssessmentCategory
  /// Null means no limit.
  maxAttempts  Int?
  cooldownDays Int                @default(0)
