  collegeId         String   @db.Uuid
  studentId         String   @unique @db.Uuid
  instrumentVersion String
  answers           Json
  scores            Json
  completedAt       DateTime @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([collegeId, completedAt])
}

// A practice interview with an AI interviewer. The transcript alternates interviewer questions and the student's answers.
model MockInterview {
  id          String    @id @default(uuid()) @db.Uuid
  collegeId   String    @db.Uuid
