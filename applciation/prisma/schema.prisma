model Question {
  id              String   @id @default(uuid()) @db.Uuid
  collegeId       String   @db.Uuid
  bankId          String   @db.Uuid
  text            String
  options         Json
  correct         Int[]
  marks           Int      @default(1)
  negativeMarks   Decimal  @default(0) @db.Decimal(4, 2)
  explanation     String?
  difficulty      String?
  tags            String[]
  /// CHOICE (single or multiple, by how many answers are correct), or SINGLE, MULTIPLE, TRUE_FALSE, FILL_BLANK, DESCRIPTIVE, CODING, SQL.
  type            String   @default("CHOICE")
  /// A passage, case study or scenario shown above the question.
  context         String?
  /// One of the test sections in lib/mockTest.ts (quantitative, logical, verbal, technical, programming, coding, sql, domain, company, case_study).
  section         String?
