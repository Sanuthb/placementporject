  updatedAt    DateTime           @updatedAt

  @@unique([collegeId, category])
}

model AssessmentSchedule {
  id                  String   @id @default(uuid()) @db.Uuid
  collegeId           String   @db.Uuid
  paperId             String   @db.Uuid
  title               String
  startsAt            DateTime
  endsAt              DateTime
  targetDepartmentIds String[] @db.Uuid
  targetBatchIds      String[] @db.Uuid
  isBaseline          Boolean  @default(false)
  isPractice          Boolean  @default(false)
  /// A limit on attempts that replaces the category's retake rule when set.
  maxAttempts         Int?
  /// SCORE_ONLY, ANALYSIS, AFTER_END or IMMEDIATE. Empty means practice tests show everything and real tests show the score only.
  resultVisibility    String?
  /// When set, only these students can see and take it (a personal practice set made by the improvement engine).
  targetStudentIds    String[] @db.Uuid
  createdById         String   @db.Uuid
  createdAt           DateTime @default(now())

  paper    AssessmentPaper     @relation(fields: [paperId], references: [id])
  attempts AssessmentAttempt[]

  @@index([collegeId, startsAt])
