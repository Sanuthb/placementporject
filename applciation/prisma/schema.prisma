  createdById   String        @db.Uuid
  createdAt     DateTime      @default(now())

  internship Internship @relation(fields: [internshipId], references: [id], onDelete: Cascade)

  @@index([internshipId])
}

// ---------- Events and fairs ----------
model Event {
