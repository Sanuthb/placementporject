  category       AssessmentCategory @default(OTHER)
  createdById    String             @db.Uuid
  createdAt      DateTime           @default(now())

  schedules AssessmentSchedule[]
}

enum AssessmentCategory {
  APTITUDE
  TECHNICAL
  COMMUNICATION
  DIGITAL_LITERACY
  TEAMWORK_LEADERSHIP
  PERSONALITY
  CAREER_INTEREST
  BEHAVIOURAL_STYLE
  OTHER
}

/// One attempt at a profile-style instrument (career interests, behavioural style, teamwork scenarios, written communication). Every attempt
