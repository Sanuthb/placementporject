// Phase 0 foundation: tenancy, modules, departments, users/roles, audit log.
// Every tenant table carries collegeId so one deployment can serve many colleges.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  TPO_ADMIN
  PLACEMENT_OFFICER
  DEPARTMENT_COORDINATOR
  // Teaching staff and mentors. Gets no placement access; only what the faculty routes explicitly allow.
  FACULTY
}

// Sellable modules (spec: "module tags"). Core is always on and is not stored.
enum ModuleKey {
  ONBOARDING
  PSYCHOMETRICS
  DRIVES
  ATTENDANCE_BLOCKING
  ANALYTICS
  ASSESSMENTS
  EMPLOYER_CRM
  STUDENT_PREP
  INTERNSHIPS
  EVENTS
  LEARNING
  RECRUITER_PORTAL
  TALENT_SHOWCASE
}

// Student profile sections (spec 2.3). Used for required-section configuration.
enum ProfileSection {
  PERSONAL
  ACADEMICS
  EDUCATION_HISTORY
  SKILLS
  PROJECTS
  INTERNSHIPS
  RESUME
  DOCUMENTS
  /// Optional by default: a college can make it required in settings.
  ACHIEVEMENTS
}

enum InviteStatus {
  NOT_SENT
  SENT
  ACTIVATED
}

enum SectionStatus {
  DRAFT
  SUBMITTED
  CHANGES_REQUESTED
  VERIFIED
}

enum StudentStage {
  PROFILE_PENDING
  VERIFIED
  ONBOARDED
}

enum ParticipationStatus {
  REGISTERED
  OPTED_OUT
  HIGHER_STUDIES
  ENTREPRENEURSHIP
  NOT_ELIGIBLE
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum VerificationAction {
  SUBMITTED
  APPROVED
  CHANGES_REQUESTED
}

enum CompanyTier {
  DREAM
  SUPER_DREAM
  CORE
  REGULAR
}

enum RelationshipStatus {
  ACTIVE
  DORMANT
  BLACKLISTED
}

enum NoteKind {
  CONVERSATION
  FOLLOW_UP
}

enum JobType {
  FULL_TIME
  INTERNSHIP
  INTERNSHIP_WITH_OFFER
}

enum DriveStatus {
  DRAFT
  PUBLISHED
  CLOSED
  CANCELLED
}

enum RoundType {
  APTITUDE
  CODING
  GROUP_DISCUSSION
  TECHNICAL
  HR
  OTHER
}

enum ApplicationStatus {
  APPLIED
  SHORTLISTED
  ON_HOLD
  REJECTED
  WITHDRAWN
}

enum RoundResultStatus {
  ATTENDED
  ABSENT
  CLEARED
  REJECTED
}

enum OfferStatus {
  OFFERED
  ACCEPTED
  DECLINED
  REVOKED
}

enum JoiningStatus {
  PENDING
  JOINED
  NOT_JOINED
}

enum ApprovalAction {
  OFFER_CREATE
  BULK_EMAIL
  BULK_STATUS_CHANGE
  ELIGIBILITY_EXCEPTION
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  SENT_BACK
}

enum MessageStatus {
  SENT
  FAILED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
}

enum CheckInMethod {
  MANUAL
  CODE
  AUTO_CLOSE
}

enum SlotStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  NO_SHOW
  CANCELLED
}

enum BlockPolicyType {
  MISSED_DRIVES
  PLACED_LOWER_TIER
}

enum BlockSource {
  POLICY
  MANUAL
}

enum BlockStatus {
  ACTIVE
  LIFTED
  EXPIRED
}

enum AlertStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

enum AlertEventKind {
  VIEW
  CLICK
  INTERESTED
}

enum TicketCategory {
  DATA_CORRECTION
  APPLICATION_ISSUE
  OTHER
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

enum ReportType {
  PLACEMENT_SUMMARY
  NIRF
}

enum ReportFrequency {
  WEEKLY
  MONTHLY
}

enum ProspectStage {
  PROSPECT
  IN_CONVERSATION
  DRIVE_SCHEDULED
  WON
  LOST
}

enum InternshipStatus {
  ALLOTTED
  ONGOING
  COMPLETED
  TERMINATED
}

enum LogStatus {
  SUBMITTED
  APPROVED
  REJECTED
}

enum EvaluatorType {
  COMPANY
  FACULTY
}

enum EventType {
  CAREER_FAIR
  HACKATHON
  CODING_CONTEST
  CASE_CHALLENGE
  WORKSHOP
}

enum EventMode {
  VIRTUAL
  ONSITE
  HYBRID
}

enum EventStatus {
  DRAFT
  PUBLISHED
  COMPLETED
  CANCELLED
}

enum RegistrationStatus {
  REGISTERED
  WAITLISTED
  CANCELLED
  ATTENDED
}

enum ProgrammeDelivery {
  IN_HOUSE
  PARTNER
}

enum ProgrammeStatus {
  ACTIVE
  COMPLETED
}

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
  AUTO_SUBMITTED
}

enum SlotState {
  OPEN
  BOOKED
  COMPLETED
  CANCELLED
}

enum ModerationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ResourceCategory {
  APTITUDE
  CODING
  INTERVIEW
  SOFT_SKILLS
  OTHER
}

enum RecruiterJobStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
}

enum ProgrammeLevel {
  DIPLOMA
  UG
  PG
  DOCTORAL
  OTHER
}

enum BatchStatus {
  UPCOMING
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum SessionStatus {
  UPCOMING
  ACTIVE
  COMPLETED
}

enum EducationStatus {
  PURSUING
  COMPLETED
  DISCONTINUED
}

enum DocCategory {
  TENTH_MARKS
  TWELFTH_MARKS
  DIPLOMA_CERTIFICATE
  DEGREE_MARKS
  DEGREE_CERTIFICATE
  PROVISIONAL_CERTIFICATE
  OTHER
}

enum DocVerification {
  PENDING
  VERIFIED
  REJECTED
}

enum ProgressionKind {
  ENROLLED
  PROMOTED
  REPEATED
  ARREAR
  TRANSFERRED
  DISCONTINUED
}

enum OnboardingStatus {
  INVITATION_PENDING
  INVITATION_SENT
  INVITATION_ACCEPTED
  PROFILE_IN_PROGRESS
  SUBMITTED
  VERIFICATION_IN_PROGRESS
  CHANGES_REQUESTED
  VERIFIED
  REJECTED
  INVITATION_EXPIRED
}

enum InvitationStatus {
  PENDING
  SENT
  ACCEPTED
  EXPIRED
  REVOKED
}

enum EmailLogStatus {
  QUEUED
  SENT
  FAILED
}

enum ImportStatus {
  PREVIEW
  PROCESSING
  COMPLETED
}

model College {
  id         String   @id @default(uuid()) @db.Uuid
  name       String
  slug       String   @unique
  logoUrl    String?
  brandColor String?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  modules               CollegeModule[]
  departments           Department[]
  users                 User[]
  auditLogs             AuditLog[]
  programs              Program[]
  academicYears         AcademicYear[]
  batches               Batch[]
  settings              CollegeSettings?
  students              Student[]
  importJobs            ImportJob[]
  campuses              Campus[]
  sections              StudentSection[]
  sectionDocs           SectionDocument[]
  verificationEvents    VerificationEvent[]
  participationHistory  ParticipationHistory[]
  participationRequests ParticipationRequest[]
  companies             Company[]
  drives                Drive[]
  offers                Offer[]
  approvals             ApprovalRequest[]
  messages              MessageLog[]
  studentInvitations    StudentInvitation[]
  universities          University[]
  facultyProfiles       FacultyProfile[]
}

model CollegeSettings {
  collegeId                  String           @id @db.Uuid
  requiredSections           ProfileSection[]
  requireAssessmentToOnboard Boolean          @default(false)
  maxOffersPerStudent        Int?             @default(1)
  enforceTierUpgrade         Boolean          @default(false)
  shareRoundScores           Boolean          @default(false)
  inviteExpiryDays           Int              @default(7)
  requireMfaForAdmins        Boolean          @default(false)
  /// Lets students and staff send an uploaded marksheet to the AI provider to read it. Off until an admin switches it on.
  aiDocumentReading          Boolean          @default(false)
  dataDeclaration            String?
  approvalRequired           ApprovalAction[]
  updatedAt                  DateTime         @updatedAt

  college College @relation(fields: [collegeId], references: [id], onDelete: Cascade)
}

model Program {
  id            String         @id @default(uuid()) @db.Uuid
  collegeId     String         @db.Uuid
  name          String
  code          String
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  departmentId  String?        @db.Uuid
  level         ProgrammeLevel @default(PG)
  qualification String?
  durationYears Int            @default(2)
  semesterCount Int            @default(4)
  // Legacy free-text name, kept so no existing data is lost. universityId is the managed link; the two are kept in step by the API.
  university    String?
  universityId  String?        @db.Uuid

  college            College           @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  department         Department?       @relation(fields: [departmentId], references: [id])
  uni                University?       @relation(fields: [universityId], references: [id])
  facultyAllocations FacultyProgram[]
  batches            Batch[]
  students           Student[]
  branches           ProgrammeBranch[]

  @@unique([collegeId, code])
  @@index([collegeId, departmentId])
  @@index([universityId])
}

/// A specialisation inside a programme, for example "Data Science" under MCA.
model ProgrammeBranch {
  id        String   @id @default(uuid()) @db.Uuid
  collegeId String   @db.Uuid
  programId String   @db.Uuid
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  program  Program   @relation(fields: [programId], references: [id], onDelete: Cascade)
  batches  Batch[]
  students Student[]

  @@unique([programId, name])
  @@index([collegeId])
}

model AcademicYear {
  id        String        @id @default(uuid()) @db.Uuid
  collegeId String        @db.Uuid
  name      String
  startDate DateTime      @db.Date
  endDate   DateTime      @db.Date
  isCurrent Boolean       @default(false)
  status    SessionStatus @default(UPCOMING)
  createdAt DateTime      @default(now())

  college     College    @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  semesters   Semester[]
  studentsNow Student[]

  @@unique([collegeId, name])
}

model Batch {
  id            String      @id @default(uuid()) @db.Uuid
  collegeId     String      @db.Uuid
  programId     String?     @db.Uuid
  name          String
  startYear     Int
  endYear       Int
  isActive      Boolean     @default(true)
  createdAt     DateTime    @default(now())
  admissionYear Int?
  branchId      String?     @db.Uuid
  coordinatorId String?     @db.Uuid
  status        BatchStatus @default(ACTIVE)

  college            College          @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  program            Program?         @relation(fields: [programId], references: [id])
  branch             ProgrammeBranch? @relation(fields: [branchId], references: [id])
  coordinator        User?            @relation("BatchCoordinator", fields: [coordinatorId], references: [id])
  students           Student[]
  semesters          Semester[]
  facultyAllocations FacultyBatch[]

  @@unique([collegeId, name])
  @@index([collegeId, programId])
}

/// One term of a batch, for example "Semester 1" of MCA 2026-2028. The batch never changes; students move through these.
model Semester {
  id             String        @id @default(uuid()) @db.Uuid
  collegeId      String        @db.Uuid
  batchId        String        @db.Uuid
  academicYearId String?       @db.Uuid
  number         Int
  name           String
  startDate      DateTime?     @db.Date
  endDate        DateTime?     @db.Date
  status         SessionStatus @default(UPCOMING)
  createdAt      DateTime      @default(now())

  batch        Batch                @relation(fields: [batchId], references: [id], onDelete: Cascade)
  academicYear AcademicYear?        @relation(fields: [academicYearId], references: [id])
  studentsNow  Student[]
  progression  StudentProgression[]
  results      SemesterResult[]

  @@unique([batchId, number])
  @@index([collegeId])
}

model CollegeModule {
  collegeId String    @db.Uuid
  module    ModuleKey
  enabled   Boolean   @default(true)
  createdAt DateTime  @default(now())

  college College @relation(fields: [collegeId], references: [id], onDelete: Cascade)

  @@id([collegeId, module])
}

model Department {
  id        String   @id @default(uuid()) @db.Uuid
  collegeId String   @db.Uuid
  name      String
  code      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  college  College             @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  users    User[]
  students Student[]
  programs Program[]
  faculty  FacultyDepartment[]

  @@unique([collegeId, code])
  @@index([collegeId])
}

// id equals the Supabase auth.users id, so the JWT subject maps directly to a row.
model User {
  id           String   @id @db.Uuid
  collegeId    String   @db.Uuid
  email        String
  name         String
  role         Role
  // Further roles on top of `role` (the main one). A person can be, for example, both Placement Officer and Department Coordinator.
  extraRoles   Role[]   @default([])
  departmentId String?  @db.Uuid
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  college              College                @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  department           Department?            @relation(fields: [departmentId], references: [id])
  auditLogs            AuditLog[]
  verificationEvents   VerificationEvent[]
  participationChanges ParticipationHistory[]
  companyNotes         CompanyNote[]
  approvalsRequested   ApprovalRequest[]      @relation("ApprovalRequester")
  approvalsDecided     ApprovalRequest[]      @relation("ApprovalDecider")
  notifications        Notification[]
  ticketsAssigned      Ticket[]               @relation("TicketAssignee")
  studentNotes         StudentNote[]
  prospectsOwned       Prospect[]
  counsellingSlots     CounsellingSlot[]
  batchesCoordinated   Batch[]                @relation("BatchCoordinator")
  documentsVerified    StudentDocument[]
  facultyProfile       FacultyProfile?
  facultyDepartments   FacultyDepartment[]
  facultyPrograms      FacultyProgram[]
  facultyBatches       FacultyBatch[]
  mentees              Student[]              @relation("StudentMentor")

  @@unique([collegeId, email])
  @@index([collegeId, role])
}

model AuditLog {
  id              String   @id @default(uuid()) @db.Uuid
  collegeId       String   @db.Uuid
  actorId         String?  @db.Uuid
  action          String
  entity          String
  entityId        String?
  before          Json?
  after           Json?
  reason          String?
  // Set instead of actorId when a platform administrator (who belongs to no college) made the change.
  platformActorId String?  @db.Uuid
  createdAt       DateTime @default(now())

  college College @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  actor   User?   @relation(fields: [actorId], references: [id])

  @@index([collegeId, createdAt])
  @@index([collegeId, entity, entityId])
}

// userId is set when the student is invited (Supabase auth user id).
model Student {
  id                    String              @id @default(uuid()) @db.Uuid
  collegeId             String              @db.Uuid
  userId                String?             @unique @db.Uuid
  enrollmentNo          String
  name                  String
  email                 String
  phone                 String?
  departmentId          String              @db.Uuid
  programId             String?             @db.Uuid
  batchId               String              @db.Uuid
  branchId              String?             @db.Uuid
  campusId              String?             @db.Uuid
  // The faculty member who mentors this student, if any.
  mentorId              String?             @db.Uuid
  admissionYear         Int?
  onboardingStatus      OnboardingStatus    @default(INVITATION_PENDING)
  lastActivityAt        DateTime?
  dateOfBirth           DateTime?           @db.Date
  gender                String?
  address               String?
  currentSemesterId     String?             @db.Uuid
  currentAcademicYearId String?             @db.Uuid
  inviteStatus          InviteStatus        @default(NOT_SENT)
  invitedAt             DateTime?
  isActive              Boolean             @default(true)
  isArchived            Boolean             @default(false)
  stage                 StudentStage        @default(PROFILE_PENDING)
  onboardedAt           DateTime?
  participationStatus   ParticipationStatus @default(REGISTERED)
  participationReason   String?
  isPlaced              Boolean             @default(false)
  placedTier            CompanyTier?
  // Privacy choices the student makes themselves.
  savedDrives           SavedDrive[]
  mockInterviews        MockInterview[]
  psychConsentAt        DateTime?
  psychShareWithStaff   Boolean             @default(false)
  emailAnnouncements    Boolean             @default(true)
  emailReminders        Boolean             @default(true)
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  college                College                     @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  department             Department                  @relation(fields: [departmentId], references: [id])
  program                Program?                    @relation(fields: [programId], references: [id])
  batch                  Batch                       @relation(fields: [batchId], references: [id])
  branch                 ProgrammeBranch?            @relation(fields: [branchId], references: [id])
  currentSemester        Semester?                   @relation(fields: [currentSemesterId], references: [id])
  currentAcademicYear    AcademicYear?               @relation(fields: [currentAcademicYearId], references: [id])
  educationRecords       StudentEducationRecord[]
  semesterResults        SemesterResult[]
  backlogs               Backlog[]
  documents              StudentDocument[]
  progression            StudentProgression[]
  sections               StudentSection[]
  verificationEvents     VerificationEvent[]
  participationHistory   ParticipationHistory[]
  participationRequests  ParticipationRequest[]
  applications           Application[]
  driveExceptions        DriveException[]
  offers                 Offer[]
  messages               MessageLog[]
  attendance             AttendanceRecord[]
  blocks                 Block[]
  notifications          Notification[]
  tickets                Ticket[]
  notes                  StudentNote[]
  psychAttempts          PsychAttempt[]
  instrumentAttempts     InstrumentAttempt[]
  roadmap                StudentRoadmap?
  courseEnrolments       CourseEnrolment[]
  resourceProgress       ResourceProgress[]
  projectMemberships     ProjectMember[]
  internshipApplications InternshipApplication[]
  resumeVersions         ResumeVersion[]
  internships            Internship[]
  eventRegistrations     EventRegistration[]
  learningMemberships    LearningMember[]
  assessmentAttempts     AssessmentAttempt[]
  counsellingBookings    CounsellingSlot[]
  interviewExperiences   InterviewExperience[]
  showcase               ShowcaseProfile?
  campus                 Campus?                     @relation(fields: [campusId], references: [id])
  invitation             StudentInvitation?
  onboardingProfile      StudentOnboardingProfile?
  correctionRequests     StudentCorrectionRequest[]
  emailLogs              InvitationEmailLog[]
  intelligenceReports    StudentIntelligenceReport[]
  mentor                 User?                       @relation("StudentMentor", fields: [mentorId], references: [id], onDelete: SetNull)
  jdShortlists           JdShortlist[]
  campaignMembers        CampaignMember[]

  @@unique([collegeId, enrollmentNo])
  @@unique([collegeId, email])
  @@index([collegeId, departmentId, batchId])
  @@index([collegeId, inviteStatus])
  @@index([collegeId, onboardingStatus])
  @@index([collegeId, mentorId])
}

// Holds the raw uploaded rows between preview and confirm; cleared once the import completes.
model ImportJob {
  id           String       @id @default(uuid()) @db.Uuid
  collegeId    String       @db.Uuid
  createdById  String       @db.Uuid
  fileName     String
  status       ImportStatus @default(PREVIEW)
  totalRows    Int
  createdCount Int          @default(0)
  skippedCount Int          @default(0)
  failedCount  Int          @default(0)
  rows         Json?
  report       Json?
  createdAt    DateTime     @default(now())
  completedAt  DateTime?

  college College @relation(fields: [collegeId], references: [id], onDelete: Cascade)

  @@index([collegeId, createdAt])
}

// One row per student per profile section. `data` is the accepted (or draft) content.
// Edits to an already-verified section go to `pendingData` so verified values are never silently overwritten.
model StudentSection {
  id            String         @id @default(uuid()) @db.Uuid
  collegeId     String         @db.Uuid
  studentId     String         @db.Uuid
  section       ProfileSection
  status        SectionStatus  @default(DRAFT)
  data          Json           @default("{}")
  pendingData   Json?
  submittedAt   DateTime?
  reviewedAt    DateTime?
  reviewComment String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  college   College           @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  student   Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  documents SectionDocument[]

  @@unique([studentId, section])
  @@index([collegeId, status, submittedAt])
}

model SectionDocument {
  id          String   @id @default(uuid()) @db.Uuid
  collegeId   String   @db.Uuid
  sectionId   String   @db.Uuid
  storagePath String
  fileName    String
  mimeType    String
  sizeBytes   Int
  createdAt   DateTime @default(now())

  college College        @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  section StudentSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@index([sectionId])
}

// Append-only history of who verified what and when.
model VerificationEvent {
  id        String             @id @default(uuid()) @db.Uuid
  collegeId String             @db.Uuid
  studentId String             @db.Uuid
  section   ProfileSection
  action    VerificationAction
  actorId   String?            @db.Uuid
  comment   String?
  snapshot  Json?
  createdAt DateTime           @default(now())

  college College @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  actor   User?   @relation(fields: [actorId], references: [id])

  @@index([studentId, createdAt])
  @@index([collegeId, createdAt])
}

model ParticipationHistory {
  id          String               @id @default(uuid()) @db.Uuid
  collegeId   String               @db.Uuid
  studentId   String               @db.Uuid
  fromStatus  ParticipationStatus?
  toStatus    ParticipationStatus
  reason      String?
  changedById String?              @db.Uuid
  createdAt   DateTime             @default(now())

  college   College @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  changedBy User?   @relation(fields: [changedById], references: [id])

  @@index([studentId, createdAt])
}

// Raised by students (student-facing spec); decided by staff here.
model ParticipationRequest {
  id              String              @id @default(uuid()) @db.Uuid
  collegeId       String              @db.Uuid
  studentId       String              @db.Uuid
  requestedStatus ParticipationStatus
  reason          String
  status          RequestStatus       @default(PENDING)
  decidedById     String?             @db.Uuid
  decisionComment String?
  decidedAt       DateTime?
  createdAt       DateTime            @default(now())

  college College @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([collegeId, status, createdAt])
}

model Company {
  id                 String             @id @default(uuid()) @db.Uuid
  collegeId          String             @db.Uuid
  name               String
  industry           String?
  website            String?
  tier               CompanyTier        @default(REGULAR)
  relationshipStatus RelationshipStatus @default(ACTIVE)
  contacts           Json               @default("[]")
  isActive           Boolean            @default(true)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  college    College       @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  drives     Drive[]
  notes      CompanyNote[]
  offers     Offer[]
  recruiters Recruiter[]

  @@unique([collegeId, name])
}

model CompanyNote {
  id           String    @id @default(uuid()) @db.Uuid
  collegeId    String    @db.Uuid
  companyId    String    @db.Uuid
  authorId     String    @db.Uuid
  kind         NoteKind  @default(CONVERSATION)
  body         String
  followUpDate DateTime? @db.Date
  createdAt    DateTime  @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  author  User    @relation(fields: [authorId], references: [id])

  @@index([companyId, createdAt])
}

model Drive {
  id                  String      @id @default(uuid()) @db.Uuid
  collegeId           String      @db.Uuid
  companyId           String      @db.Uuid
  role                String
  jobType             JobType
  location            String?
  packageMinLpa       Decimal?    @db.Decimal(6, 2)
  packageMaxLpa       Decimal?    @db.Decimal(6, 2)
  venue               String?
  description         String?
  applicationDeadline DateTime
  driveDate           DateTime
  status              DriveStatus @default(DRAFT)

  // Eligibility rules. Empty arrays mean "no restriction".
  minCgpa           Decimal? @db.Decimal(4, 2)
  minTenthPct       Decimal? @db.Decimal(5, 2)
  minTwelfthPct     Decimal? @db.Decimal(5, 2)
  maxActiveBacklogs Int?
  departmentIds     String[] @db.Uuid
  batchIds          String[] @db.Uuid
  programIds        String[] @db.Uuid
  allowPlaced       Boolean  @default(false)

  createdById  String    @db.Uuid
  publishedAt  DateTime?
  closedAt     DateTime?
  cancelReason String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  college            College             @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  company            Company             @relation(fields: [companyId], references: [id])
  rounds             DriveRound[]
  documents          DriveDocument[]
  exceptions         DriveException[]
  applications       Application[]
  feedback           DriveFeedback?
  offers             Offer[]
  attendanceSessions AttendanceSession[]
  attendance         AttendanceRecord[]
  savedBy            SavedDrive[]
  panels             InterviewPanel[]
  slots              InterviewSlot[]
  prospects          Prospect[]
  jd                 JobDescription?

  @@index([collegeId, status, driveDate])
  @@index([companyId])
}

model DriveRound {
  id          String    @id @default(uuid()) @db.Uuid
  driveId     String    @db.Uuid
  order       Int
  type        RoundType
  name        String?
  scheduledAt DateTime?
  venue       String?

  drive   Drive           @relation(fields: [driveId], references: [id], onDelete: Cascade)
  results RoundResult[]
  slots   InterviewSlot[]

  @@unique([driveId, order])
}

model DriveDocument {
  id          String   @id @default(uuid()) @db.Uuid
  driveId     String   @db.Uuid
  storagePath String
  fileName    String
  mimeType    String
  sizeBytes   Int
  createdAt   DateTime @default(now())

  drive Drive @relation(fields: [driveId], references: [id], onDelete: Cascade)

  @@index([driveId])
}

// Lets a specific student apply despite failing the rules. Never overrides hard criteria
// (inactive, archived, not onboarded, not registered for placement).
model DriveException {
  id          String   @id @default(uuid()) @db.Uuid
  driveId     String   @db.Uuid
  studentId   String   @db.Uuid
  reason      String
  createdById String   @db.Uuid
  createdAt   DateTime @default(now())

  drive   Drive   @relation(fields: [driveId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([driveId, studentId])
}

model Application {
  id               String            @id @default(uuid()) @db.Uuid
  collegeId        String            @db.Uuid
  driveId          String            @db.Uuid
  studentId        String            @db.Uuid
  status           ApplicationStatus @default(APPLIED)
  appliedAt        DateTime          @default(now())
  decidedById      String?           @db.Uuid
  // Round progress. currentRound is the order of the round the student is waiting for.
  currentRound     Int?
  clearedAllRounds Boolean           @default(false)
  // The resume as it was when the student applied: the verified profile data, and optionally a copy of the file they picked.
  resumeSnapshot   Json?
  resumeFilePath   String?
  resumeFileName   String?
  updatedAt        DateTime          @updatedAt

  drive   Drive              @relation(fields: [driveId], references: [id], onDelete: Cascade)
  student Student            @relation(fields: [studentId], references: [id], onDelete: Cascade)
  events  ApplicationEvent[]
  results RoundResult[]
  offers  Offer[]
  slots   InterviewSlot[]

  @@unique([driveId, studentId])
  @@index([collegeId, studentId])
  @@index([driveId, status])
}

// Timeline of every status change per student per drive.
model ApplicationEvent {
  id            String             @id @default(uuid()) @db.Uuid
  applicationId String             @db.Uuid
  status        ApplicationStatus?
  roundId       String?            @db.Uuid
  roundResult   RoundResultStatus?
  actorId       String?            @db.Uuid
  note          String?
  createdAt     DateTime           @default(now())

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId, createdAt])
}

model DriveFeedback {
  driveId      String   @id @db.Uuid
  onStudents   String?
  onProcess    String?
  improvements String?
  updatedAt    DateTime @updatedAt

  drive Drive @relation(fields: [driveId], references: [id], onDelete: Cascade)
}

model RoundResult {
  id            String            @id @default(uuid()) @db.Uuid
  applicationId String            @db.Uuid
  roundId       String            @db.Uuid
  status        RoundResultStatus
  score         Decimal?          @db.Decimal(7, 2)
  remarks       String?
  recordedById  String?           @db.Uuid
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  round       DriveRound  @relation(fields: [roundId], references: [id], onDelete: Cascade)

  @@unique([applicationId, roundId])
  @@index([roundId, status])
}

model Offer {
  id                 String        @id @default(uuid()) @db.Uuid
  collegeId          String        @db.Uuid
  applicationId      String?       @db.Uuid
  driveId            String?       @db.Uuid
  isHistorical       Boolean       @default(false)
  offerYear          Int?
  studentId          String        @db.Uuid
  companyId          String        @db.Uuid
  role               String
  packageLpa         Decimal       @db.Decimal(6, 2)
  isPpo              Boolean       @default(false)
  status             OfferStatus   @default(OFFERED)
  expiresAt          DateTime?
  letterPath         String?
  letterName         String?
  offeredAt          DateTime      @default(now())
  respondedAt        DateTime?
  revokeReason       String?
  joiningStatus      JoiningStatus @default(PENDING)
  joiningDate        DateTime?     @db.Date
  // What the student reports: the date they joined and an optional proof file. Staff confirm through joiningStatus.
  studentJoiningDate DateTime?     @db.Date
  joiningProofPath   String?
  joiningProofName   String?
  createdById        String        @db.Uuid
  updatedAt          DateTime      @updatedAt

  college     College      @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  application Application? @relation(fields: [applicationId], references: [id])
  drive       Drive?       @relation(fields: [driveId], references: [id])
  student     Student      @relation(fields: [studentId], references: [id])
  company     Company      @relation(fields: [companyId], references: [id])

  @@index([collegeId, status])
  @@index([studentId, status])
  @@index([driveId])
  @@index([companyId, status])
}

// Actions the college marked "needs approval" wait here; nothing happens until an approver decides.
model ApprovalRequest {
  id              String         @id @default(uuid()) @db.Uuid
  collegeId       String         @db.Uuid
  action          ApprovalAction
  status          ApprovalStatus @default(PENDING)
  summary         String
  payload         Json
  requestedById   String         @db.Uuid
  decidedById     String?        @db.Uuid
  decisionComment String?
  decidedAt       DateTime?
  executedAt      DateTime?
  executionError  String?
  result          Json?
  createdAt       DateTime       @default(now())

  college     College @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  requestedBy User    @relation("ApprovalRequester", fields: [requestedById], references: [id])
  decidedBy   User?   @relation("ApprovalDecider", fields: [decidedById], references: [id])

  @@index([collegeId, status, createdAt])
}

// History of messages sent and to whom.
model MessageLog {
  id                String        @id @default(uuid()) @db.Uuid
  collegeId         String        @db.Uuid
  purpose           String
  subject           String
  recipientEmail    String
  studentId         String?       @db.Uuid
  status            MessageStatus
  error             String?
  sentById          String?       @db.Uuid
  approvalRequestId String?       @db.Uuid
  createdAt         DateTime      @default(now())

  college College  @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  student Student? @relation(fields: [studentId], references: [id])

  @@index([collegeId, createdAt])
}

// One session per drive (roundKey "drive") or per round (roundKey = roundId). The code is what students scan or type.
model AttendanceSession {
  id         String    @id @default(uuid()) @db.Uuid
  collegeId  String    @db.Uuid
  driveId    String    @db.Uuid
  roundId    String?   @db.Uuid
  roundKey   String
  code       String
  isOpen     Boolean   @default(true)
  openedAt   DateTime  @default(now())
  closedAt   DateTime?
  closedById String?   @db.Uuid

  drive Drive @relation(fields: [driveId], references: [id], onDelete: Cascade)

  @@unique([driveId, roundKey])
}

model AttendanceRecord {
  id           String           @id @default(uuid()) @db.Uuid
  collegeId    String           @db.Uuid
  driveId      String           @db.Uuid
  roundId      String?          @db.Uuid
  roundKey     String
  studentId    String           @db.Uuid
  status       AttendanceStatus
  method       CheckInMethod
  excused      Boolean          @default(false)
  excuseReason String?
  markedById   String?          @db.Uuid
  markedAt     DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  drive   Drive   @relation(fields: [driveId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([driveId, roundKey, studentId])
  @@index([studentId, status])
  @@index([collegeId, status])
}

model InterviewPanel {
  id        String   @id @default(uuid()) @db.Uuid
  driveId   String   @db.Uuid
  name      String
  room      String?
  createdAt DateTime @default(now())

  drive Drive           @relation(fields: [driveId], references: [id], onDelete: Cascade)
  slots InterviewSlot[]

  @@unique([driveId, name])
}

model InterviewSlot {
  id              String     @id @default(uuid()) @db.Uuid
  collegeId       String     @db.Uuid
  driveId         String     @db.Uuid
  roundId         String     @db.Uuid
  panelId         String     @db.Uuid
  applicationId   String     @db.Uuid
  startsAt        DateTime
  endsAt          DateTime
  status          SlotStatus @default(SCHEDULED)
  notes           String?
  rescheduleCount Int        @default(0)
  createdById     String     @db.Uuid
  updatedAt       DateTime   @updatedAt

  drive       Drive          @relation(fields: [driveId], references: [id], onDelete: Cascade)
  round       DriveRound     @relation(fields: [roundId], references: [id], onDelete: Cascade)
  panel       InterviewPanel @relation(fields: [panelId], references: [id], onDelete: Cascade)
  application Application    @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([panelId, startsAt])
  @@index([applicationId])
  @@index([driveId, roundId])
}

// params by type. MISSED_DRIVES: { threshold, blockDays, windowDays?, graceHours? }. PLACED_LOWER_TIER: {}.
model BlockPolicy {
  id        String          @id @default(uuid()) @db.Uuid
  collegeId String          @db.Uuid
  type      BlockPolicyType
  name      String
  params    Json
  isActive  Boolean         @default(true)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@index([collegeId, isActive])
}

model Block {
  id          String      @id @default(uuid()) @db.Uuid
  collegeId   String      @db.Uuid
  studentId   String      @db.Uuid
  source      BlockSource
  policyId    String?     @db.Uuid
  reason      String
  startsAt    DateTime    @default(now())
  endsAt      DateTime
  status      BlockStatus @default(ACTIVE)
  evidence    Json?
  createdById String?     @db.Uuid
  liftedById  String?     @db.Uuid
  liftReason  String?
  liftedAt    DateTime?
  notifiedAt  DateTime?
  createdAt   DateTime    @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([collegeId, status, endsAt])
  @@index([studentId, status])
}

model JobAlert {
  id                  String      @id @default(uuid()) @db.Uuid
  collegeId           String      @db.Uuid
  title               String
  companyName         String
  jobType             JobType
  location            String?
  description         String?
  applyUrl            String
  deadline            DateTime?
  targetDepartmentIds String[]    @db.Uuid
  targetBatchIds      String[]    @db.Uuid
  targetSkills        String[]
  status              AlertStatus @default(DRAFT)
  createdById         String      @db.Uuid
  publishedAt         DateTime?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  events JobAlertEvent[]

  @@index([collegeId, status])
}

model JobAlertEvent {
  id        String         @id @default(uuid()) @db.Uuid
  alertId   String         @db.Uuid
  studentId String         @db.Uuid
  kind      AlertEventKind
  createdAt DateTime       @default(now())

  alert JobAlert @relation(fields: [alertId], references: [id], onDelete: Cascade)

  @@index([alertId, kind])
}

// In-app notification for a staff member (userId) or a student (studentId).
model Notification {
  id        String    @id @default(uuid()) @db.Uuid
  collegeId String    @db.Uuid
  userId    String?   @db.Uuid
  studentId String?   @db.Uuid
  type      String
  title     String
  body      String?
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user    User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  student Student? @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@index([studentId, readAt, createdAt])
}

// Shown on the student dashboard (student app reads these).
model Announcement {
  id                  String    @id @default(uuid()) @db.Uuid
  collegeId           String    @db.Uuid
  title               String
  body                String
  targetDepartmentIds String[]  @db.Uuid
  targetBatchIds      String[]  @db.Uuid
  publishedAt         DateTime  @default(now())
  expiresAt           DateTime?
  isActive            Boolean   @default(true)
  createdById         String    @db.Uuid
  createdAt           DateTime  @default(now())

  @@index([collegeId, isActive, publishedAt])
}

model MessageTemplate {
  id          String   @id @default(uuid()) @db.Uuid
  collegeId   String   @db.Uuid
  name        String
  subject     String
  body        String
  createdById String   @db.Uuid
  updatedAt   DateTime @updatedAt

  @@unique([collegeId, name])
}

model Ticket {
  id           String          @id @default(uuid()) @db.Uuid
  collegeId    String          @db.Uuid
  studentId    String          @db.Uuid
  departmentId String          @db.Uuid
  category     TicketCategory
  section      ProfileSection?
  subject      String
  status       TicketStatus    @default(OPEN)
  assigneeId   String?         @db.Uuid
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  resolvedAt   DateTime?

  student     Student            @relation(fields: [studentId], references: [id], onDelete: Cascade)
  assignee    User?              @relation("TicketAssignee", fields: [assigneeId], references: [id])
  messages    TicketMessage[]
  attachments TicketAttachment[]

  @@index([collegeId, status, createdAt])
  @@index([assigneeId, status])
}

model TicketMessage {
  id              String   @id @default(uuid()) @db.Uuid
  ticketId        String   @db.Uuid
  authorUserId    String?  @db.Uuid
  authorStudentId String?  @db.Uuid
  body            String
  createdAt       DateTime @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
}

// A screenshot or document the student attached to a support request.
model TicketAttachment {
  id          String   @id @default(uuid()) @db.Uuid
  ticketId    String   @db.Uuid
  storagePath String
  fileName    String
  mimeType    String
  sizeBytes   Int
  createdAt   DateTime @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
}

// Questions and placement rules the college publishes for students. Staff edit them; students read them.
model FaqItem {
  id          String   @id @default(uuid()) @db.Uuid
  collegeId   String   @db.Uuid
  kind        String   @default("FAQ")
  question    String
  answer      String
  sortOrder   Int      @default(0)
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([collegeId, isPublished, sortOrder])
}

model StudentNote {
  id        String   @id @default(uuid()) @db.Uuid
  collegeId String   @db.Uuid
  studentId String   @db.Uuid
  authorId  String   @db.Uuid
  body      String
  createdAt DateTime @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  author  User    @relation(fields: [authorId], references: [id])

  @@index([studentId, createdAt])
}

model ReportSchedule {
  id          String          @id @default(uuid()) @db.Uuid
  collegeId   String          @db.Uuid
  type        ReportType
  frequency   ReportFrequency
  recipients  String[]
  nextRunAt   DateTime
  lastRunAt   DateTime?
  lastError   String?
  isActive    Boolean         @default(true)
  createdById String          @db.Uuid
  createdAt   DateTime        @default(now())

  @@index([isActive, nextRunAt])
}

// Personality and aptitude results live apart from academic data and are never read by eligibility or blocking.
/// Every attempt is kept, so a student's results can be compared over time. Exactly one row per student has `isCurrent` (the newest);
/// everything that reads "the" result (cohort figures, staff view, onboarding gate) reads only that row.
model PsychAttempt {
  id                String   @id @default(uuid()) @db.Uuid
  collegeId         String   @db.Uuid
  studentId         String   @db.Uuid
  instrumentVersion String
  answers           Json
  scores            Json
  completedAt       DateTime @default(now())
  isCurrent         Boolean  @default(true)

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([collegeId, completedAt])
  @@index([studentId, isCurrent])
}

// A practice interview with an AI interviewer. The transcript alternates interviewer questions and the student's answers.
model MockInterview {
  id          String    @id @default(uuid()) @db.Uuid
  collegeId   String    @db.Uuid
  studentId   String    @db.Uuid
  role        String
  topic       String
  status      String    @default("IN_PROGRESS")
  transcript  Json      @default("[]")
  feedback    Json?
  createdAt   DateTime  @default(now())
  completedAt DateTime?

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, createdAt])
}

// A drive a student bookmarked to look at later.
model SavedDrive {
  studentId String   @db.Uuid
  driveId   String   @db.Uuid
  createdAt DateTime @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  drive   Drive   @relation(fields: [driveId], references: [id], onDelete: Cascade)

  @@id([studentId, driveId])
}

// Every time staff open a student's profile, so the student can see who looked.
model ProfileView {
  id        String   @id @default(uuid()) @db.Uuid
  collegeId String   @db.Uuid
  studentId String   @db.Uuid
  actorId   String   @db.Uuid
  createdAt DateTime @default(now())

  @@index([studentId, createdAt])
  @@index([actorId, studentId, createdAt])
}

// Every time staff open an individual result.
model PsychAccessLog {
  id        String   @id @default(uuid()) @db.Uuid
  collegeId String   @db.Uuid
  actorId   String   @db.Uuid
  studentId String   @db.Uuid
  reason    String
  createdAt DateTime @default(now())

  @@index([collegeId, createdAt])
  @@index([studentId])
}

// ---------- Employer CRM ----------
model Prospect {
  id             String        @id @default(uuid()) @db.Uuid
  collegeId      String        @db.Uuid
  companyName    String
  industry       String?
  contactName    String?
  contactEmail   String?
  contactPhone   String?
  stage          ProspectStage @default(PROSPECT)
  ownerId        String        @db.Uuid
  companyId      String?       @db.Uuid
  driveId        String?       @db.Uuid
  notes          String?
  nextFollowUpAt DateTime?
  lastReminderAt DateTime?
  lostReason     String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  owner      User               @relation(fields: [ownerId], references: [id])
  drive      Drive?             @relation(fields: [driveId], references: [id])
  activities ProspectActivity[]

  @@index([collegeId, stage])
  @@index([nextFollowUpAt])
}

model ProspectActivity {
  id         String   @id @default(uuid()) @db.Uuid
  prospectId String   @db.Uuid
  authorId   String   @db.Uuid
  kind       String
  body       String
  createdAt  DateTime @default(now())

  prospect Prospect @relation(fields: [prospectId], references: [id], onDelete: Cascade)

  @@index([prospectId, createdAt])
}

// ---------- Internships ----------
model Internship {
  id                    String            @id @default(uuid()) @db.Uuid
  collegeId             String            @db.Uuid
  studentId             String            @db.Uuid
  companyId             String?           @db.Uuid
  companyName           String
  role                  String
  startDate             DateTime          @db.Date
  endDate               DateTime          @db.Date
  mentorName            String?
  mentorEmail           String?
  postingId             String?           @db.Uuid
  applicationId         String?           @unique @db.Uuid
  /// The faculty member who follows the student through the internship (the company's own mentor is mentorName / mentorEmail).
  facultyMentorId       String?           @db.Uuid
  /// Working days, 0 = Sunday to 6 = Saturday, and hours in a normal day.
  workDays              Int[]             @default([1, 2, 3, 4, 5])
  hoursPerDay           Int               @default(8)
  scheduleNote          String?
  stipendInr            Int?
  certificatePath       String?
  certificateName       String?
  certificateMime       String?
  certificateStatus     CertificateStatus @default(NONE)
  certificateNote       String?
  certificateUploadedAt DateTime?
  ppoStatus             PpoStatus         @default(NONE)
  ppoOfferId            String?           @db.Uuid
  ppoNote               String?
  completedAt           DateTime?
  /// Set when an admin completed the internship although a required check was not met.
  completionOverride    String?
  status                InternshipStatus  @default(ALLOTTED)
  createdById           String            @db.Uuid
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  student     Student                @relation(fields: [studentId], references: [id], onDelete: Cascade)
  logs        WorkLog[]
  evaluations InternshipEvaluation[]
  attendance  InternshipAttendance[]
  tasks       InternshipTask[]
  feedback    InternshipFeedback[]
  links       InternshipMentorLink[]

  @@index([collegeId, status])
  @@index([studentId])
}

model WorkLog {
  id            String    @id @default(uuid()) @db.Uuid
  internshipId  String    @db.Uuid
  weekStart     DateTime  @db.Date
  hours         Int
  summary       String
  status        LogStatus @default(SUBMITTED)
  reviewComment String?
  reviewedById  String?   @db.Uuid
  createdAt     DateTime  @default(now())

  internship Internship @relation(fields: [internshipId], references: [id], onDelete: Cascade)

  @@unique([internshipId, weekStart])
}

model InternshipEvaluation {
  id            String        @id @default(uuid()) @db.Uuid
  internshipId  String        @db.Uuid
  evaluatorType EvaluatorType
  evaluatorName String
  score         Int
  remarks       String?
  createdById   String        @db.Uuid
  createdAt     DateTime      @default(now())

  internship Internship @relation(fields: [internshipId], references: [id], onDelete: Cascade)

  @@index([internshipId])
}

// ---------- Events and fairs ----------
model Event {
  id                   String      @id @default(uuid()) @db.Uuid
  collegeId            String      @db.Uuid
  type                 EventType
  title                String
  description          String?
  mode                 EventMode
  venue                String?
  joinUrl              String?
  startsAt             DateTime
  endsAt               DateTime
  registrationDeadline DateTime?
  capacity             Int?
  targetDepartmentIds  String[]    @db.Uuid
  targetBatchIds       String[]    @db.Uuid
  status               EventStatus @default(DRAFT)
  createdById          String      @db.Uuid
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  registrations EventRegistration[]

  @@index([collegeId, status, startsAt])
}

model EventRegistration {
  id           String             @id @default(uuid()) @db.Uuid
  eventId      String             @db.Uuid
  studentId    String             @db.Uuid
  status       RegistrationStatus @default(REGISTERED)
  rank         Int?
  score        Decimal?           @db.Decimal(8, 2)
  registeredAt DateTime           @default(now())

  event   Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([eventId, studentId])
  @@index([studentId])
}

// ---------- Learning programmes ----------
model LearningJourney {
  id          String   @id @default(uuid()) @db.Uuid
  collegeId   String   @db.Uuid
  name        String
  description String?
  steps       Json
  createdAt   DateTime @default(now())

  programmes LearningProgramme[]

  @@unique([collegeId, name])
}

model LearningProgramme {
  id          String            @id @default(uuid()) @db.Uuid
  collegeId   String            @db.Uuid
  title       String
  goal        String
  delivery    ProgrammeDelivery @default(IN_HOUSE)
  partnerName String?
  journeyId   String?           @db.Uuid
  startsAt    DateTime?
  endsAt      DateTime?
  status      ProgrammeStatus   @default(ACTIVE)
  createdById String            @db.Uuid
  createdAt   DateTime          @default(now())

  journey LearningJourney? @relation(fields: [journeyId], references: [id])
  members LearningMember[]

  @@index([collegeId, status])
}

model LearningMember {
  id          String   @id @default(uuid()) @db.Uuid
  programmeId String   @db.Uuid
  studentId   String   @db.Uuid
  joinedAt    DateTime @default(now())

  programme LearningProgramme  @relation(fields: [programmeId], references: [id], onDelete: Cascade)
  student   Student            @relation(fields: [studentId], references: [id], onDelete: Cascade)
  progress  LearningProgress[]

  @@unique([programmeId, studentId])
  @@index([studentId])
}

model LearningProgress {
  id          String   @id @default(uuid()) @db.Uuid
  memberId    String   @db.Uuid
  stepIndex   Int
  completedAt DateTime @default(now())

  member LearningMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([memberId, stepIndex])
}

// ---------- Assessments builder ----------
model QuestionBank {
  id        String   @id @default(uuid()) @db.Uuid
  collegeId String   @db.Uuid
  name      String
  topic     String?
  createdAt DateTime @default(now())

  questions Question[]

  @@unique([collegeId, name])
}

model Question {
  id            String   @id @default(uuid()) @db.Uuid
  collegeId     String   @db.Uuid
  bankId        String   @db.Uuid
  text          String
  options       Json
  correct       Int[]
  marks         Int      @default(1)
  negativeMarks Decimal  @default(0) @db.Decimal(4, 2)
  explanation   String?
  difficulty    String?
  tags          String[]
  createdAt     DateTime @default(now())

  bank QuestionBank @relation(fields: [bankId], references: [id], onDelete: Cascade)

  @@index([bankId])
}

model AssessmentPaper {
  id           String             @id @default(uuid()) @db.Uuid
  collegeId    String             @db.Uuid
  title        String
  instructions String?
  durationMin  Int
  questions    Json
  shuffle      Boolean            @default(true)
  proctoring   Json
  passPercent  Int?
  /// Which part of the career profile this paper measures. Its schedules and attempts inherit it.
  category     AssessmentCategory @default(OTHER)
  createdById  String             @db.Uuid
  createdAt    DateTime           @default(now())

  schedules AssessmentSchedule[]
}

enum AssessmentCategory {
  APTITUDE
  TECHNICAL
  COMMUNICATION
  DIGITAL_LITERACY
  TEAMWORK_LEADERSHIP
  PERSONALITY
  CAREER_INTEREST
  BEHAVIOURAL_STYLE
  OTHER
}

/// One attempt at a profile-style instrument (career interests, behavioural style, teamwork scenarios, written communication). Every attempt
/// is kept; exactly one per student and instrument is current. Whether staff may see it depends on the instrument (see lib/instruments).
model InstrumentAttempt {
  id                String   @id @default(uuid()) @db.Uuid
  collegeId         String   @db.Uuid
  studentId         String   @db.Uuid
  instrumentKey     String
  instrumentVersion String
  attemptNumber     Int      @default(1)
  answers           Json
  scores            Json
  completedAt       DateTime @default(now())
  isCurrent         Boolean  @default(true)

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, instrumentKey, attemptNumber])
  @@index([collegeId, instrumentKey, isCurrent])
  @@index([studentId, instrumentKey])
}

/// A college's retake rule for one category. Without a row the defaults in lib/reassessment.ts apply (the behaviour before rules existed).
model ReassessmentRule {
  id           String             @id @default(uuid()) @db.Uuid
  collegeId    String             @db.Uuid
  category     AssessmentCategory
  /// Null means no limit.
  maxAttempts  Int?
  cooldownDays Int                @default(0)
  updatedById  String?            @db.Uuid
  updatedAt    DateTime           @updatedAt

  @@unique([collegeId, category])
}

model AssessmentSchedule {
  id                  String   @id @default(uuid()) @db.Uuid
  collegeId           String   @db.Uuid
  paperId             String   @db.Uuid
  title               String
  startsAt            DateTime
  endsAt              DateTime
  targetDepartmentIds String[] @db.Uuid
  targetBatchIds      String[] @db.Uuid
  isBaseline          Boolean  @default(false)
  isPractice          Boolean  @default(false)
  createdById         String   @db.Uuid
  createdAt           DateTime @default(now())

  paper    AssessmentPaper     @relation(fields: [paperId], references: [id])
  attempts AssessmentAttempt[]

  @@index([collegeId, startsAt])
}

model AssessmentAttempt {
  id            String        @id @default(uuid()) @db.Uuid
  scheduleId    String        @db.Uuid
  studentId     String        @db.Uuid
  startedAt     DateTime      @default(now())
  deadlineAt    DateTime
  submittedAt   DateTime?
  answers       Json          @default("{}")
  score         Decimal?      @db.Decimal(8, 2)
  maxScore      Decimal?      @db.Decimal(8, 2)
  violations    Int           @default(0)
  flagged       Boolean       @default(false)
  proctorEvents Json          @default("[]")
  status        AttemptStatus @default(IN_PROGRESS)
  /// 1 for the first attempt; retakes (when the category's rule allows them) count up. Earlier attempts are kept.
  attemptNumber Int           @default(1)

  schedule AssessmentSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  student  Student            @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([scheduleId, studentId, attemptNumber])
  @@index([scheduleId, studentId])
  @@index([studentId])
}

// ---------- Student preparation ----------
enum ResourceType {
  DOCUMENT
  IMAGE
  VIDEO
  AUDIO
  VIDEO_LINK
  WEBSITE
  QUESTION_BANK
  SAMPLE_TEST
  CODING_PRACTICE
  COMPANY_MATERIAL
}

enum ResourceStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  REJECTED
  ARCHIVED
}

/// ALL_STUDENTS: in the library for every student. ASSIGNED_ONLY: only students it was assigned to. STAFF_ONLY: never shown to students.
enum ResourceVisibility {
  ALL_STUDENTS
  ASSIGNED_ONLY
  STAFF_ONLY
}

enum ResourceDifficulty {
  EASY
  MEDIUM
  HARD
}

enum ResourceTarget {
  STUDENT
  DEPARTMENT
  BATCH
  GROUP
  SKILL_GAP
  MOCK_TEST
}

/// A preparation resource: a file or a link, with metadata, an approval workflow, versions and assignments. Students see only approved, unexpired ones.
model PrepResource {
  id           String              @id @default(uuid()) @db.Uuid
  collegeId    String              @db.Uuid
  title        String
  category     ResourceCategory
  type         ResourceType        @default(WEBSITE)
  url          String?
  filePath     String?
  fileName     String?
  mimeType     String?
  sizeBytes    Int?
  description  String?
  subject      String?
  topic        String?
  skills       String[]
  jobRoles     String[]
  companyName  String?
  difficulty   ResourceDifficulty?
  language     String              @default("English")
  durationMin  Int?
  status       ResourceStatus      @default(DRAFT)
  version      Int                 @default(1)
  expiresAt    DateTime?
  visibility   ResourceVisibility  @default(ASSIGNED_ONLY)
  uploadedById String?             @db.Uuid
  reviewedById String?             @db.Uuid
  reviewedAt   DateTime?
  reviewNote   String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @default(now()) @updatedAt

  versions    ResourceVersion[]
  assignments ResourceAssignment[]
  progress    ResourceProgress[]

  @@index([collegeId, status])
}

/// An earlier version of a resource's content, kept when a new file or link replaces it.
model ResourceVersion {
  id          String   @id @default(uuid()) @db.Uuid
  resourceId  String   @db.Uuid
  version     Int
  url         String?
  filePath    String?
  fileName    String?
  mimeType    String?
  sizeBytes   Int?
  createdById String?  @db.Uuid
  createdAt   DateTime @default(now())

  resource PrepResource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@unique([resourceId, version])
}

/// Who a resource is assigned to. targetId is a student, department, batch, learning programme (group) or assessment paper; SKILL_GAP uses targetKey (aptitude, technical, ...).
model ResourceAssignment {
  id           String         @id @default(uuid()) @db.Uuid
  resourceId   String         @db.Uuid
  collegeId    String         @db.Uuid
  targetType   ResourceTarget
  targetId     String?        @db.Uuid
  targetKey    String?
  note         String?
  dueAt        DateTime?
  assignedById String         @db.Uuid
  createdAt    DateTime       @default(now())

  resource PrepResource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@index([resourceId])
  @@index([collegeId, targetType, targetId])
}

/// One student's use of one resource: opened, completed, and their feedback.
model ResourceProgress {
  id               String    @id @default(uuid()) @db.Uuid
  resourceId       String    @db.Uuid
  studentId        String    @db.Uuid
  collegeId        String    @db.Uuid
  openedAt         DateTime?
  completedAt      DateTime?
  completedVersion Int?
  rating           Int?
  feedback         String?
  updatedAt        DateTime  @default(now()) @updatedAt

  resource PrepResource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  student  Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([resourceId, studentId])
  @@index([studentId])
}

model CounsellingSlot {
  id           String    @id @default(uuid()) @db.Uuid
  collegeId    String    @db.Uuid
  counsellorId String    @db.Uuid
  startsAt     DateTime
  endsAt       DateTime
  status       SlotState @default(OPEN)
  studentId    String?   @db.Uuid
  topic        String?
  notes        String?
  createdAt    DateTime  @default(now())

  counsellor User     @relation(fields: [counsellorId], references: [id])
  student    Student? @relation(fields: [studentId], references: [id])

  @@index([collegeId, status, startsAt])
}

model InterviewExperience {
  id             String           @id @default(uuid()) @db.Uuid
  collegeId      String           @db.Uuid
  studentId      String           @db.Uuid
  companyName    String
  role           String
  roundType      RoundType?
  experience     String
  difficulty     Int
  status         ModerationStatus @default(PENDING)
  moderatedById  String?          @db.Uuid
  moderationNote String?
  createdAt      DateTime         @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([collegeId, status, createdAt])
}

// ---------- Recruiter portal ----------
model Recruiter {
  id        String   @id @db.Uuid
  collegeId String   @db.Uuid
  companyId String   @db.Uuid
  email     String
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  company Company        @relation(fields: [companyId], references: [id])
  jobs    RecruiterJob[]

  @@unique([collegeId, email])
  @@index([companyId])
}

model RecruiterJob {
  id           String             @id @default(uuid()) @db.Uuid
  collegeId    String             @db.Uuid
  recruiterId  String             @db.Uuid
  title        String
  jobType      JobType
  location     String?
  description  String?
  applyUrl     String
  deadline     DateTime?
  status       RecruiterJobStatus @default(PENDING_REVIEW)
  reviewedById String?            @db.Uuid
  reviewNote   String?
  jobAlertId   String?            @db.Uuid
  createdAt    DateTime           @default(now())

  recruiter Recruiter @relation(fields: [recruiterId], references: [id])

  @@index([collegeId, status])
}

// ---------- Talent showcase ----------
model ShowcaseProfile {
  id          String    @id @default(uuid()) @db.Uuid
  collegeId   String    @db.Uuid
  studentId   String    @unique @db.Uuid
  token       String    @unique
  isEnabled   Boolean   @default(true)
  headline    String?
  showCgpa    Boolean   @default(false)
  showContact Boolean   @default(false)
  expiresAt   DateTime?
  views       Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([collegeId, isEnabled])
}

// Fixed-window counters for rate limiting. Shared by every server instance, so limits hold behind a load balancer.
model RateLimitBucket {
  key         String
  windowStart BigInt
  count       Int      @default(1)
  createdAt   DateTime @default(now())

  @@id([key, windowStart])
  @@index([createdAt])
}

/// One row per previous or current qualification (SSLC, PUC, BCA, MCA ...).
model StudentEducationRecord {
  id                String          @id @default(uuid()) @db.Uuid
  collegeId         String          @db.Uuid
  studentId         String          @db.Uuid
  level             String
  qualification     String
  specialisation    String?
  institution       String
  boardOrUniversity String?
  rollNo            String?
  admissionYear     Int?
  completionYear    Int?
  percentage        Decimal?        @db.Decimal(5, 2)
  cgpa              Decimal?        @db.Decimal(4, 2)
  maxMarks          Int?
  obtainedMarks     Int?
  backlogs          Int             @default(0)
  status            EducationStatus @default(COMPLETED)
  isCurrent         Boolean         @default(false)
  // Review state, moved together with the student's EDUCATION_HISTORY section. An edit to a verified record waits in `pendingData`.
  reviewStatus      SectionStatus   @default(DRAFT)
  reviewComment     String?
  pendingData       Json?
  verifiedAt        DateTime?
  verifiedById      String?         @db.Uuid
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([collegeId, studentId])
}

enum ResultStatus {
  PASS
  FAIL
  WITHHELD
  ONGOING
}

enum AttemptOutcome {
  FAILED
  CLEARED
}

/// One semester of the degree. Moves through review with the student's ACADEMICS section. The percentage is never stored: it is worked out from the subject marks.
model SemesterResult {
  id             String        @id @default(uuid()) @db.Uuid
  collegeId      String        @db.Uuid
  studentId      String        @db.Uuid
  // The M2 semester this result belongs to, when the student's batch has one with this number.
  semesterId     String?       @db.Uuid
  semesterNumber Int
  sgpa           Decimal?      @db.Decimal(4, 2)
  resultStatus   ResultStatus  @default(PASS)
  reviewStatus   SectionStatus @default(DRAFT)
  reviewComment  String?
  // A proposed change to a verified semester (same shape as the input). Applied only when staff approve.
  pendingData    Json?
  verifiedAt     DateTime?
  verifiedById   String?       @db.Uuid
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  student  Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  semester Semester?     @relation(fields: [semesterId], references: [id])
  subjects SubjectMark[]

  @@unique([studentId, semesterNumber])
  @@index([collegeId, studentId])
}

model SubjectMark {
  id               String   @id @default(uuid()) @db.Uuid
  collegeId        String   @db.Uuid
  semesterResultId String   @db.Uuid
  code             String?
  name             String
  marksObtained    Decimal  @db.Decimal(7, 2)
  maxMarks         Decimal  @db.Decimal(7, 2)
  credits          Decimal? @db.Decimal(4, 1)
  grade            String?
  gradePoints      Decimal? @db.Decimal(4, 2)

  semesterResult SemesterResult @relation(fields: [semesterResultId], references: [id], onDelete: Cascade)

  @@index([semesterResultId])
}

/// A subject the student has failed. Attempts are only ever added: clearing the subject adds a CLEARED attempt, it never erases the earlier ones.
model Backlog {
  id             String   @id @default(uuid()) @db.Uuid
  collegeId      String   @db.Uuid
  studentId      String   @db.Uuid
  subjectName    String
  subjectCode    String?
  semesterNumber Int
  createdAt      DateTime @default(now())

  student  Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  attempts BacklogAttempt[]

  @@unique([studentId, semesterNumber, subjectName])
  @@index([collegeId, studentId])
}

model BacklogAttempt {
  id                String         @id @default(uuid()) @db.Uuid
  collegeId         String         @db.Uuid
  backlogId         String         @db.Uuid
  attemptNumber     Int
  examSession       String?
  marksObtained     Decimal?       @db.Decimal(7, 2)
  outcome           AttemptOutcome
  clearedInSemester Int?
  reviewStatus      SectionStatus  @default(DRAFT)
  reviewComment     String?
  verifiedAt        DateTime?
  verifiedById      String?        @db.Uuid
  createdAt         DateTime       @default(now())

  backlog Backlog @relation(fields: [backlogId], references: [id], onDelete: Cascade)

  @@unique([backlogId, attemptNumber])
}

/// A single uploaded academic document with its own verification state.
model StudentDocument {
  id            String          @id @default(uuid()) @db.Uuid
  collegeId     String          @db.Uuid
  studentId     String          @db.Uuid
  category      DocCategory
  storagePath   String
  fileName      String
  mimeType      String
  sizeBytes     Int
  status        DocVerification @default(PENDING)
  verifiedById  String?         @db.Uuid
  verifiedAt    DateTime?
  rejectReason  String?
  createdAt     DateTime        @default(now())
  /// SHA-256 of the file bytes: stops the same file being uploaded twice and proves a replacement really differs.
  sha256        String?
  /// The document this one replaced. The older file is kept, archived, and never removed from storage.
  replacesId    String?         @db.Uuid
  /// Set when the document is removed or replaced. Archived rows stay for history and audit; every live view filters them out.
  archivedAt    DateTime?
  archivedById  String?         @db.Uuid
  archiveReason String?

  student     Student              @relation(fields: [studentId], references: [id], onDelete: Cascade)
  verifiedBy  User?                @relation(fields: [verifiedById], references: [id])
  extractions DocumentExtraction[]

  @@index([collegeId, studentId])
  @@index([collegeId, status])
  @@index([studentId, sha256])
}

enum ExtractionStatus {
  DONE
  FAILED
}

/// What the AI read from one document, and the suggestions made from it. Never verifies anything: a suggestion only fills the student's draft
/// when the student accepts it, and staff still check the document by eye. Rows are kept (newest wins) for audit.
model DocumentExtraction {
  id            String           @id @default(uuid()) @db.Uuid
  collegeId     String           @db.Uuid
  studentId     String           @db.Uuid
  documentId    String           @db.Uuid
  status        ExtractionStatus
  model         String
  /// The fields as read, after validation. Null when the read failed.
  fields        Json?
  /// Comparisons with the student's records: [{ key, kind, label, current, suggested, state }].
  suggestions   Json             @default("[]")
  error         String?
  /// Null when the student asked for the read.
  requestedById String?          @db.Uuid
  createdAt     DateTime         @default(now())

  document StudentDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId, createdAt])
  @@index([collegeId, studentId])
}

/// History of a student moving through semesters. Rows are only added, never overwritten.
model StudentProgression {
  id             String          @id @default(uuid()) @db.Uuid
  collegeId      String          @db.Uuid
  studentId      String          @db.Uuid
  semesterId     String?         @db.Uuid
  academicYearId String?         @db.Uuid
  kind           ProgressionKind
  note           String?
  createdById    String?         @db.Uuid
  createdAt      DateTime        @default(now())

  student  Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  semester Semester? @relation(fields: [semesterId], references: [id])

  @@index([collegeId, studentId, createdAt])
}

/// A campus of the institution. Optional: a single-campus college can leave it empty.
model Campus {
  id        String   @id @default(uuid()) @db.Uuid
  collegeId String   @db.Uuid
  name      String
  code      String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  college     College             @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  students    Student[]
  invitations StudentInvitation[]

  @@unique([collegeId, name])
}

/// One invitation per student. The token itself is never stored, only its SHA-256 hash. Resending or copying a link issues a new token and
/// invalidates the old one. The assigned academic structure is copied here so the invitation shows what the student was told.
model StudentInvitation {
  id              String           @id @default(uuid()) @db.Uuid
  collegeId       String           @db.Uuid
  studentId       String           @unique @db.Uuid
  invitedEmail    String
  admissionNumber String
  campusId        String?          @db.Uuid
  departmentId    String           @db.Uuid
  programId       String?          @db.Uuid
  branchId        String?          @db.Uuid
  batchId         String           @db.Uuid
  admissionYear   Int?
  graduationYear  Int?
  tokenHash       String           @unique
  expiresAt       DateTime
  status          InvitationStatus @default(PENDING)
  sentAt          DateTime?
  acceptedAt      DateTime?
  lastResentAt    DateTime?
  resendCount     Int              @default(0)
  failedAttempts  Int              @default(0)
  revokedAt       DateTime?
  createdById     String?          @db.Uuid
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  college College              @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  student Student              @relation(fields: [studentId], references: [id], onDelete: Cascade)
  campus  Campus?              @relation(fields: [campusId], references: [id])
  emails  InvitationEmailLog[]

  @@index([collegeId, status])
  @@index([status, expiresAt])
}

/// What the student has entered in the onboarding wizard so far. Saved as a draft at every step; copied into the
/// verified profile sections only when the student submits.
model StudentOnboardingProfile {
  id                    String    @id @default(uuid()) @db.Uuid
  collegeId             String    @db.Uuid
  studentId             String    @unique @db.Uuid
  currentStep           Int       @default(1)
  personal              Json      @default("{}")
  academics             Json      @default("{}")
  career                Json      @default("{}")
  declarationAcceptedAt DateTime?
  declarationText       String?
  submittedAt           DateTime?
  proposedName          String?
  nameDecidedAt         DateTime?
  reviewNote            String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([collegeId])
}

/// A student asking staff to fix something they were assigned (department, batch...). Students never edit those fields themselves.
model StudentCorrectionRequest {
  id           String        @id @default(uuid()) @db.Uuid
  collegeId    String        @db.Uuid
  studentId    String        @db.Uuid
  field        String
  message      String
  status       RequestStatus @default(PENDING)
  resolvedById String?       @db.Uuid
  resolvedAt   DateTime?
  createdAt    DateTime      @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([collegeId, status])
  @@index([studentId])
}

/// One row per invitation email attempt. Holds no token or link.
model InvitationEmailLog {
  id           String         @id @default(uuid()) @db.Uuid
  collegeId    String         @db.Uuid
  invitationId String         @db.Uuid
  studentId    String         @db.Uuid
  toEmail      String
  subject      String
  kind         String
  status       EmailLogStatus @default(QUEUED)
  error        String?
  createdAt    DateTime       @default(now())
  sentAt       DateTime?

  invitation StudentInvitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  student    Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([invitationId, createdAt])
  @@index([collegeId, status])
}

/// An AI-written reading of a student's evidence. The scores in `dimensions` are computed by code from records; the AI only writes
/// `narrative`. A new row is added on every refresh, so earlier readings stay available for comparison.
model StudentIntelligenceReport {
  id            String   @id @default(uuid()) @db.Uuid
  collegeId     String   @db.Uuid
  studentId     String   @db.Uuid
  inputHash     String
  dimensions    Json
  narrative     Json
  model         String
  generatedById String?  @db.Uuid
  createdAt     DateTime @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, createdAt])
  @@index([collegeId])
}

/// One row per sign-in session (the session id comes from the signed token), written by the app after sign-in. Staff, students and recruiters.
model LoginEvent {
  id        String   @id @default(uuid()) @db.Uuid
  collegeId String?  @db.Uuid
  userId    String   @db.Uuid
  kind      String
  sessionId String   @unique
  method    String?
  mfa       Boolean  @default(false)
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([collegeId, createdAt])
}

/// A university a college's programmes are affiliated to. Scoped to one college, like the programmes that point at it.
model University {
  id        String   @id @default(uuid()) @db.Uuid
  collegeId String   @db.Uuid
  name      String
  code      String
  website   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  college  College   @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  programs Program[]

  // Names are also unique ignoring case, through a lower(name) index created in the migration.
  @@unique([collegeId, code])
  @@index([collegeId])
}

/// Extra details for a staff member who has the FACULTY role. Sign-in, status and name stay on User.
model FacultyProfile {
  userId         String    @id @db.Uuid
  collegeId      String    @db.Uuid
  employeeId     String?
  designation    String?
  qualification  String?
  specialisation String?
  phone          String?
  joinedOn       DateTime? @db.Date
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  college College @relation(fields: [collegeId], references: [id], onDelete: Cascade)

  @@unique([collegeId, employeeId])
  @@index([collegeId])
}

/// Which departments a faculty member belongs to.
model FacultyDepartment {
  userId       String @db.Uuid
  departmentId String @db.Uuid
  collegeId    String @db.Uuid

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@id([userId, departmentId])
  @@index([collegeId, departmentId])
}

/// Programmes a faculty member teaches or oversees. Gives access to those programmes' students.
model FacultyProgram {
  userId    String @db.Uuid
  programId String @db.Uuid
  collegeId String @db.Uuid

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  program Program @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@id([userId, programId])
  @@index([collegeId, programId])
}

/// Batches a faculty member is allocated to. Gives access to those batches' students.
model FacultyBatch {
  userId    String @db.Uuid
  batchId   String @db.Uuid
  collegeId String @db.Uuid

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  batch Batch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@id([userId, batchId])
  @@index([collegeId, batchId])
}

/// People who run the platform and can create institutions. They belong to no college and have no User row, so they reach no tenant data.
/// Rows are added only from the command line (npm run db:platform-admin); no API grants this.
model PlatformAdmin {
  id        String   @id @db.Uuid
  email     String   @unique
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

/// Security trail for platform administration (sign-in protection, MFA enrolment / challenges / removal / recovery). Platform admins belong to no
/// college, so this cannot live in AuditLog. No foreign key, so history survives the removal of an administrator.
model PlatformAuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  adminId   String?  @db.Uuid
  email     String?
  action    String
  detail    Json?
  ip        String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([adminId, createdAt])
}

// ---------- Career roadmap (M5) ----------
enum MilestoneStatus {
  PLANNED
  IN_PROGRESS
  DONE
  SKIPPED
}

enum RoadmapGoalStatus {
  OPEN
  ACHIEVED
  DROPPED
}

/// One roadmap per student, built from the programme's own length. The student owns it and may change it; every change is kept in RoadmapEvent.
model StudentRoadmap {
  id              String   @id @default(uuid()) @db.Uuid
  collegeId       String   @db.Uuid
  studentId       String   @unique @db.Uuid
  /// Semesters in the student's programme when the roadmap was made.
  totalSemesters  Int
  targetRole      String?
  careerGoal      String?
  templateVersion String   @default("1")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  student    Student            @relation(fields: [studentId], references: [id], onDelete: Cascade)
  milestones RoadmapMilestone[]
  goals      RoadmapGoal[]
  comments   RoadmapComment[]
  events     RoadmapEvent[]

  @@index([collegeId])
}

model RoadmapMilestone {
  id          String          @id @default(uuid()) @db.Uuid
  roadmapId   String          @db.Uuid
  collegeId   String          @db.Uuid
  /// Library key for template milestones ("d-profile"), "rec:..." for accepted recommendations, null for the student's own.
  key         String?
  semester    Int
  phase       String
  category    String
  title       String
  description String?
  /// Name of the rule that ticks it automatically from system data, if any.
  auto        String?
  status      MilestoneStatus @default(PLANNED)
  /// TEMPLATE, RECOMMENDED or CUSTOM.
  source      String          @default("TEMPLATE")
  completedAt DateTime?
  /// AUTO, STUDENT or MENTOR.
  completedBy String?
  note        String?
  sortOrder   Int             @default(0)
  /// A removed milestone is archived, not deleted, so the history stays complete.
  archivedAt  DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  roadmap StudentRoadmap @relation(fields: [roadmapId], references: [id], onDelete: Cascade)

  @@index([roadmapId, semester])
  @@index([collegeId, status])
}

model RoadmapGoal {
  id          String            @id @default(uuid()) @db.Uuid
  roadmapId   String            @db.Uuid
  collegeId   String            @db.Uuid
  title       String
  description String?
  targetDate  DateTime?         @db.Date
  status      RoadmapGoalStatus @default(OPEN)
  achievedAt  DateTime?
  createdAt   DateTime          @default(now())

  roadmap StudentRoadmap @relation(fields: [roadmapId], references: [id], onDelete: Cascade)

  @@index([roadmapId])
}

/// A note from a mentor or staff member to the student, shown on the roadmap.
model RoadmapComment {
  id         String   @id @default(uuid()) @db.Uuid
  roadmapId  String   @db.Uuid
  collegeId  String   @db.Uuid
  authorId   String   @db.Uuid
  authorName String
  /// MENTOR or STAFF.
  authorRole String
  body       String
  createdAt  DateTime @default(now())

  roadmap StudentRoadmap @relation(fields: [roadmapId], references: [id], onDelete: Cascade)

  @@index([roadmapId, createdAt])
}

/// Every change to a roadmap: who did it, what, and when.
model RoadmapEvent {
  id        String   @id @default(uuid()) @db.Uuid
  roadmapId String   @db.Uuid
  collegeId String   @db.Uuid
  /// STUDENT, MENTOR, STAFF or SYSTEM.
  actor     String
  actorId   String?  @db.Uuid
  action    String
  detail    Json     @default("{}")
  createdAt DateTime @default(now())

  roadmap StudentRoadmap @relation(fields: [roadmapId], references: [id], onDelete: Cascade)

  @@index([roadmapId, createdAt])
}

// ---------- Learning management: courses (M6) ----------
enum CourseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum LessonType {
  VIDEO
  DOCUMENT
  LINK
  TEXT
  ASSIGNMENT
  QUIZ
  LIVE
}

enum EnrolmentStatus {
  ENROLLED
  COMPLETED
  WITHDRAWN
}

enum SubmissionStatus {
  SUBMITTED
  GRADED
  RETURNED
}

/// A course made by staff: modules, then lessons (chapters). Students browse published courses and enrol, or staff enrol a group.
model Course {
  id                 String       @id @default(uuid()) @db.Uuid
  collegeId          String       @db.Uuid
  title              String
  summary            String?
  description        String?
  category           String?
  level              String?
  skills             String[]
  /// Who may see and join it. Empty means every student of the college.
  departmentId       String?      @db.Uuid
  batchId            String?      @db.Uuid
  status             CourseStatus @default(DRAFT)
  certificateEnabled Boolean      @default(true)
  /// When false only staff can enrol students.
  selfEnrol          Boolean      @default(true)
  createdById        String       @db.Uuid
  publishedAt        DateTime?
  archivedAt         DateTime?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  modules      CourseModule[]
  lessons      CourseLesson[]
  enrolments   CourseEnrolment[]
  certificates CourseCertificate[]

  @@index([collegeId, status])
}

model CourseModule {
  id        String @id @default(uuid()) @db.Uuid
  courseId  String @db.Uuid
  title     String
  sortOrder Int    @default(0)

  course  Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons CourseLesson[]

  @@index([courseId])
}

/// One chapter. What it needs depends on its type: VIDEO and DOCUMENT use a link or an uploaded file, TEXT uses body, ASSIGNMENT uses body/dueAt/maxMarks,
/// QUIZ uses questions/passPercent/maxAttempts, LIVE uses url (meeting link), startsAt and durationMin.
model CourseLesson {
  id           String     @id @default(uuid()) @db.Uuid
  courseId     String     @db.Uuid
  moduleId     String     @db.Uuid
  collegeId    String     @db.Uuid
  type         LessonType
  title        String
  body         String?
  url          String?
  filePath     String?
  fileName     String?
  mimeType     String?
  sizeBytes    Int?
  downloadable Boolean    @default(false)
  /// Counts towards finishing the course.
  required     Boolean    @default(true)
  sortOrder    Int        @default(0)
  maxMarks     Int?
  dueAt        DateTime?
  startsAt     DateTime?
  durationMin  Int?
  passPercent  Int?
  maxAttempts  Int?
  questions    Json?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  course      Course                 @relation(fields: [courseId], references: [id], onDelete: Cascade)
  module      CourseModule           @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  progress    LessonProgress[]
  attempts    QuizAttempt[]
  submissions AssignmentSubmission[]
  doubts      CourseQuestion[]

  @@index([courseId])
  @@index([moduleId])
}

model CourseEnrolment {
  id             String          @id @default(uuid()) @db.Uuid
  courseId       String          @db.Uuid
  studentId      String          @db.Uuid
  collegeId      String          @db.Uuid
  status         EnrolmentStatus @default(ENROLLED)
  /// The staff user who enrolled the student, or null when the student joined on their own.
  enrolledById   String?         @db.Uuid
  enrolledAt     DateTime        @default(now())
  completedAt    DateTime?
  lastActivityAt DateTime        @default(now())

  course      Course                 @relation(fields: [courseId], references: [id], onDelete: Cascade)
  student     Student                @relation(fields: [studentId], references: [id], onDelete: Cascade)
  progress    LessonProgress[]
  attempts    QuizAttempt[]
  submissions AssignmentSubmission[]
  doubts      CourseQuestion[]
  certificate CourseCertificate?

  @@unique([courseId, studentId])
  @@index([studentId])
  @@index([collegeId])
}

model LessonProgress {
  id          String   @id @default(uuid()) @db.Uuid
  enrolmentId String   @db.Uuid
  lessonId    String   @db.Uuid
  completedAt DateTime @default(now())

  enrolment CourseEnrolment @relation(fields: [enrolmentId], references: [id], onDelete: Cascade)
  lesson    CourseLesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([enrolmentId, lessonId])
  @@index([lessonId])
}

model QuizAttempt {
  id            String   @id @default(uuid()) @db.Uuid
  lessonId      String   @db.Uuid
  enrolmentId   String   @db.Uuid
  studentId     String   @db.Uuid
  attemptNumber Int
  /// The chosen option per question (null = skipped).
  answers       Json
  score         Int
  total         Int
  percent       Int
  passed        Boolean
  createdAt     DateTime @default(now())

  lesson    CourseLesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  enrolment CourseEnrolment @relation(fields: [enrolmentId], references: [id], onDelete: Cascade)

  @@unique([lessonId, enrolmentId, attemptNumber])
  @@index([studentId])
}

model AssignmentSubmission {
  id          String           @id @default(uuid()) @db.Uuid
  lessonId    String           @db.Uuid
  enrolmentId String           @db.Uuid
  studentId   String           @db.Uuid
  text        String?
  filePath    String?
  fileName    String?
  mimeType    String?
  status      SubmissionStatus @default(SUBMITTED)
  marks       Int?
  feedback    String?
  gradedById  String?          @db.Uuid
  gradedAt    DateTime?
  submittedAt DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  lesson    CourseLesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  enrolment CourseEnrolment @relation(fields: [enrolmentId], references: [id], onDelete: Cascade)

  @@unique([lessonId, enrolmentId])
  @@index([studentId])
}

/// A student's question about a course or one lesson, answered by staff.
model CourseQuestion {
  id           String    @id @default(uuid()) @db.Uuid
  courseId     String    @db.Uuid
  lessonId     String?   @db.Uuid
  enrolmentId  String    @db.Uuid
  studentId    String    @db.Uuid
  collegeId    String    @db.Uuid
  question     String
  answer       String?
  answeredById String?   @db.Uuid
  answeredAt   DateTime?
  createdAt    DateTime  @default(now())

  lesson    CourseLesson?   @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  enrolment CourseEnrolment @relation(fields: [enrolmentId], references: [id], onDelete: Cascade)

  @@index([courseId, answeredAt])
  @@index([studentId])
}

model CourseCertificate {
  id          String   @id @default(uuid()) @db.Uuid
  courseId    String   @db.Uuid
  enrolmentId String   @unique @db.Uuid
  studentId   String   @db.Uuid
  collegeId   String   @db.Uuid
  serial      String   @unique
  issuedAt    DateTime @default(now())

  course    Course          @relation(fields: [courseId], references: [id], onDelete: Cascade)
  enrolment CourseEnrolment @relation(fields: [enrolmentId], references: [id], onDelete: Cascade)

  @@index([studentId])
}

// ---------- Projects and portfolio (M8) ----------
enum ProjectType {
  INDIVIDUAL
  TEAM
  INTERDISCIPLINARY
}

/// PROPOSED: a student's own idea waiting for approval. OPEN: students can take it. CLOSED: no new teams. REJECTED: a proposal that was turned down.
enum ProjectStatus {
  PROPOSED
  DRAFT
  OPEN
  CLOSED
  ARCHIVED
  REJECTED
}

enum TeamStatus {
  FORMING
  ACTIVE
  SUBMITTED
  EVALUATED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum ReviewerType {
  FACULTY
  INDUSTRY
  STAFF
}

enum ProjectFileKind {
  DOCUMENT
  PRESENTATION
}

/// A problem statement in the college's project repository. Teams (one student for an individual project) take it up and do the work.
model Project {
  id                String        @id @default(uuid()) @db.Uuid
  collegeId         String        @db.Uuid
  title             String
  problemStatement  String
  skills            String[]
  type              ProjectType   @default(TEAM)
  status            ProjectStatus @default(DRAFT)
  minTeamSize       Int           @default(1)
  maxTeamSize       Int           @default(1)
  /// Who may take it. Empty means every department / batch.
  departmentIds     String[]      @db.Uuid
  batchIds          String[]      @db.Uuid
  /// The faculty member who guides and reviews it.
  guideId           String?       @db.Uuid
  industryPartner   String?
  startsAt          DateTime?
  dueAt             DateTime?
  /// When true students may start or join teams themselves; otherwise staff allocate.
  selfFormTeams     Boolean       @default(true)
  maxTeams          Int?
  /// Milestones every team gets: [{ title, dueInDays }], counted from the team's start.
  milestoneTemplate Json          @default("[]")
  proposedById      String?       @db.Uuid
  createdById       String?       @db.Uuid
  rejectReason      String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @default(now()) @updatedAt

  teams   ProjectTeam[]
  members ProjectMember[]

  @@index([collegeId, status])
}

model ProjectTeam {
  id                String     @id @default(uuid()) @db.Uuid
  projectId         String     @db.Uuid
  collegeId         String     @db.Uuid
  name              String
  leaderId          String     @db.Uuid
  status            TeamStatus @default(FORMING)
  summary           String?
  repoUrl           String?
  /// Commit figures read from GitHub: { fullName, pushedAt, totalCommits, contributors: [{ login, commits }], fetchedAt }.
  repoStats         Json?
  repoSyncedAt      DateTime?
  startedAt         DateTime?
  submittedAt       DateTime?
  /// The published result, as a percentage. Students see it only once resultPublishedAt is set.
  finalPercent      Int?
  resultPublishedAt DateTime?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @default(now()) @updatedAt

  project    Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  members    ProjectMember[]
  milestones ProjectMilestone[]
  tasks      ProjectTask[]
  updates    ProjectUpdate[]
  files      ProjectFile[]
  reviews    ProjectReview[]
  invites    ProjectMentorInvite[]

  @@index([projectId])
  @@index([collegeId])
}

model ProjectMember {
  id              String   @id @default(uuid()) @db.Uuid
  teamId          String   @db.Uuid
  projectId       String   @db.Uuid
  studentId       String   @db.Uuid
  collegeId       String   @db.Uuid
  /// Stated by the student; used to match commits to people. Not verified.
  githubUsername  String?
  role            String?
  showInPortfolio Boolean  @default(true)
  joinedAt        DateTime @default(now())

  team    ProjectTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)
  project Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  student Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([projectId, studentId])
  @@index([studentId])
  @@index([teamId])
}

model ProjectMilestone {
  id        String    @id @default(uuid()) @db.Uuid
  teamId    String    @db.Uuid
  title     String
  dueAt     DateTime?
  sortOrder Int       @default(0)
  doneAt    DateTime?

  team  ProjectTeam   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  tasks ProjectTask[]

  @@index([teamId])
}

model ProjectTask {
  id                 String     @id @default(uuid()) @db.Uuid
  teamId             String     @db.Uuid
  milestoneId        String?    @db.Uuid
  title              String
  description        String?
  assigneeId         String?    @db.Uuid
  status             TaskStatus @default(TODO)
  dueAt              DateTime?
  completedAt        DateTime?
  createdByStudentId String?    @db.Uuid
  createdByUserId    String?    @db.Uuid
  createdAt          DateTime   @default(now())

  team      ProjectTeam       @relation(fields: [teamId], references: [id], onDelete: Cascade)
  milestone ProjectMilestone? @relation(fields: [milestoneId], references: [id], onDelete: SetNull)

  @@index([teamId])
}

/// A progress update from a student, or a note from a faculty member or staff.
model ProjectUpdate {
  id           String   @id @default(uuid()) @db.Uuid
  teamId       String   @db.Uuid
  studentId    String?  @db.Uuid
  authorUserId String?  @db.Uuid
  text         String
  createdAt    DateTime @default(now())

  team ProjectTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId, createdAt])
}

model ProjectFile {
  id                  String          @id @default(uuid()) @db.Uuid
  teamId              String          @db.Uuid
  kind                ProjectFileKind
  title               String
  filePath            String
  fileName            String
  mimeType            String
  sizeBytes           Int
  uploadedByStudentId String?         @db.Uuid
  createdAt           DateTime        @default(now())

  team ProjectTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId])
}

/// One review of a team by a faculty guide, staff member or an industry mentor. `scores` has a 0-10 mark per rubric criterion; `individualMarks` optionally
/// marks single students (0-10) so one person's contribution can differ from the team's result.
model ProjectReview {
  id              String       @id @default(uuid()) @db.Uuid
  teamId          String       @db.Uuid
  reviewerType    ReviewerType
  reviewerName    String
  reviewerUserId  String?      @db.Uuid
  inviteId        String?      @db.Uuid
  comments        String?
  scores          Json
  individualMarks Json         @default("{}")
  percent         Int
  isFinal         Boolean      @default(false)
  createdAt       DateTime     @default(now())

  team ProjectTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId])
}

/// A one-time link that lets an industry mentor (who has no account) review one team.
model ProjectMentorInvite {
  id          String    @id @default(uuid()) @db.Uuid
  teamId      String    @db.Uuid
  collegeId   String    @db.Uuid
  name        String
  email       String
  tokenHash   String    @unique
  expiresAt   DateTime
  usedAt      DateTime?
  createdById String    @db.Uuid
  createdAt   DateTime  @default(now())

  team ProjectTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId])
}

// ---------- Internship management (M9) ----------
enum InternshipMode {
  ONSITE
  REMOTE
  HYBRID
}

enum PostingStatus {
  DRAFT
  OPEN
  CLOSED
  CANCELLED
}

enum InternshipApplicationStatus {
  APPLIED
  COLLEGE_APPROVED
  COLLEGE_REJECTED
  COMPANY_SELECTED
  COMPANY_REJECTED
  WITHDRAWN
  ALLOTTED
}

enum AttendanceMark {
  PRESENT
  ABSENT
  LEAVE
}

enum InternshipTaskStatus {
  ASSIGNED
  SUBMITTED
  APPROVED
  CHANGES_REQUESTED
}

enum CertificateStatus {
  NONE
  PENDING
  VERIFIED
  REJECTED
}

enum PpoStatus {
  NONE
  EXPECTED
  OFFERED
  ACCEPTED
  DECLINED
}

/// An internship a company offers through the college. Staff post it once the company has confirmed it.
model InternshipPosting {
  id                   String         @id @default(uuid()) @db.Uuid
  collegeId            String         @db.Uuid
  companyId            String?        @db.Uuid
  companyName          String
  title                String
  description          String?
  location             String?
  mode                 InternshipMode @default(ONSITE)
  stipendInr           Int?
  openings             Int?
  skills               String[]
  startDate            DateTime       @db.Date
  endDate              DateTime       @db.Date
  applicationDeadline  DateTime
  /// Whether the company has confirmed the internship; a posting cannot open without it.
  companyConfirmed     Boolean        @default(false)
  companyConfirmedNote String?
  minCgpa              Decimal?       @db.Decimal(4, 2)
  minTenthPct          Decimal?       @db.Decimal(5, 2)
  minTwelfthPct        Decimal?       @db.Decimal(5, 2)
  maxActiveBacklogs    Int?
  departmentIds        String[]       @db.Uuid
  batchIds             String[]       @db.Uuid
  programIds           String[]       @db.Uuid
  allowPlaced          Boolean        @default(true)
  status               PostingStatus  @default(DRAFT)
  createdById          String         @db.Uuid
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @default(now()) @updatedAt

  applications InternshipApplication[]

  @@index([collegeId, status])
}

/// A student's application to a posting, or an internship they found themselves that needs the college's approval.
model InternshipApplication {
  id                 String                      @id @default(uuid()) @db.Uuid
  collegeId          String                      @db.Uuid
  studentId          String                      @db.Uuid
  postingId          String?                     @db.Uuid
  selfSourced        Boolean                     @default(false)
  companyName        String?
  role               String?
  startDate          DateTime?                   @db.Date
  endDate            DateTime?                   @db.Date
  mentorName         String?
  mentorEmail        String?
  offerLetterPath    String?
  offerLetterName    String?
  note               String?
  status             InternshipApplicationStatus @default(APPLIED)
  /// Why the student did not meet the rules when they applied (staff may still approve).
  eligibilityGaps    String[]
  collegeDecidedById String?                     @db.Uuid
  collegeDecidedAt   DateTime?
  collegeNote        String?
  companyDecidedAt   DateTime?
  companyNote        String?
  createdAt          DateTime                    @default(now())
  updatedAt          DateTime                    @default(now()) @updatedAt

  posting InternshipPosting? @relation(fields: [postingId], references: [id], onDelete: SetNull)
  student Student            @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([postingId, studentId])
  @@index([collegeId, status])
  @@index([studentId])
}

/// A student's attendance for one working day. The student marks it; a mentor or staff verify or correct it.
model InternshipAttendance {
  id           String         @id @default(uuid()) @db.Uuid
  internshipId String         @db.Uuid
  date         DateTime       @db.Date
  status       AttendanceMark
  note         String?
  markedBy     String         @default("STUDENT")
  verified     Boolean        @default(false)
  verifiedById String?        @db.Uuid
  updatedAt    DateTime       @default(now()) @updatedAt

  internship Internship @relation(fields: [internshipId], references: [id], onDelete: Cascade)

  @@unique([internshipId, date])
}

/// Work given to the intern, handed in by them and reviewed. `isFinalReport` marks the closing report.
model InternshipTask {
  id               String               @id @default(uuid()) @db.Uuid
  internshipId     String               @db.Uuid
  title            String
  description      String?
  dueAt            DateTime?
  isFinalReport    Boolean              @default(false)
  status           InternshipTaskStatus @default(ASSIGNED)
  assignedByName   String
  assignedByUserId String?              @db.Uuid
  submissionText   String?
  submissionUrl    String?
  filePath         String?
  fileName         String?
  fileMime         String?
  submittedAt      DateTime?
  reviewComment    String?
  reviewedByName   String?
  reviewedAt       DateTime?
  createdAt        DateTime             @default(now())

  internship Internship @relation(fields: [internshipId], references: [id], onDelete: Cascade)

  @@index([internshipId])
}

/// Mentor feedback: from the faculty mentor, staff or the company's mentor (through a link).
model InternshipFeedback {
  id           String       @id @default(uuid()) @db.Uuid
  internshipId String       @db.Uuid
  authorType   ReviewerType
  authorName   String
  authorUserId String?      @db.Uuid
  text         String
  createdAt    DateTime     @default(now())

  internship Internship @relation(fields: [internshipId], references: [id], onDelete: Cascade)

  @@index([internshipId, createdAt])
}

/// A one-time link that lets the company's mentor, who has no account, give an evaluation and feedback.
model InternshipMentorLink {
  id           String    @id @default(uuid()) @db.Uuid
  internshipId String    @db.Uuid
  collegeId    String    @db.Uuid
  name         String
  email        String
  tokenHash    String    @unique
  expiresAt    DateTime
  usedAt       DateTime?
  createdById  String    @db.Uuid
  createdAt    DateTime  @default(now())

  internship Internship @relation(fields: [internshipId], references: [id], onDelete: Cascade)

  @@index([internshipId])
}

// ---------- Dynamic resume engine (M10) ----------
enum ResumeKind {
  MASTER
  TECHNICAL
  MANAGEMENT
  INTERNSHIP
  FRESHER
  PROJECT_BASED
  COMPANY_SPECIFIC
}

enum ResumeStatus {
  DRAFT
  APPROVED
  ARCHIVED
}

/// One resume a student made from their master profile. A draft is rebuilt from the live profile each time it is opened; approving it freezes `doc`.
/// An approved version never changes: editing it makes a new draft, so the history of what was sent stays true.
model ResumeVersion {
  id            String       @id @default(uuid()) @db.Uuid
  collegeId     String       @db.Uuid
  studentId     String       @db.Uuid
  number        Int
  title         String
  kind          ResumeKind   @default(MASTER)
  template      String       @default("ATS")
  targetCompany String?
  targetRole    String?
  targetText    String?
  /// What the student changed by hand: { summary, headline, hide: [keys], text: { key: text } }.
  edits         Json         @default("{}")
  /// Only checked material (true) or everything the student entered (false).
  verifiedOnly  Boolean      @default(false)
  markEvidence  Boolean      @default(true)
  status        ResumeStatus @default(DRAFT)
  /// The finished document, kept when the version is approved.
  doc           Json?
  /// Keys of the profile items the document was made from, to tell later what is new.
  profileKeys   String[]
  approvedAt    DateTime?
  isPrimary     Boolean      @default(false)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @default(now()) @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, number])
  @@index([studentId, status])
  @@index([collegeId])
}

// ---------- Job description management (M11) ----------
enum JdStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  ARCHIVED
}

enum JdSource {
  UPLOAD
  PASTE
  MANUAL
}

/// A job description as structured, reviewed data. `data` holds the title, requirements (each mandatory or preferred, weighted), eligibility rules, selection process and
/// scoring weights (see lib/jd.ts). Nothing built from it (a drive, the matching engine) may use it before it is APPROVED by an authorised person.
model JobDescription {
  id              String    @id @default(uuid()) @db.Uuid
  collegeId       String    @db.Uuid
  driveId         String?   @unique @db.Uuid
  companyId       String?   @db.Uuid
  source          JdSource
  status          JdStatus  @default(DRAFT)
  /// Copied out of `data` for lists and search.
  title           String
  companyName     String
  rawText         String?
  fileName        String?
  filePath        String?
  mimeType        String?
  sizeBytes       Int?
  data            Json
  /// Things the extraction could not be sure about, shown to the reviewer.
  extractionNotes String[]
  extractedAt     DateTime?
  reviewNote      String?
  submittedAt     DateTime?
  approvedById    String?   @db.Uuid
  approvedAt      DateTime?
  createdById     String    @db.Uuid
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @default(now()) @updatedAt

  drive     Drive?         @relation(fields: [driveId], references: [id], onDelete: SetNull)
  shortlist JdShortlist[]
  campaigns PrepCampaign[]

  @@index([collegeId, status])
}

/// A student a person chose from the match ranking for a job description. The score and the evidence at that moment are kept, so the decision can be explained later.
/// This only invites and records; the final selection stays with the drive's rounds and the people who run them.
model JdShortlist {
  id              String   @id @default(uuid()) @db.Uuid
  collegeId       String   @db.Uuid
  jdId            String   @db.Uuid
  studentId       String   @db.Uuid
  score           Int
  mandatoryStatus String
  /// The weights, parameter scores, skills and explanation as they were when the person shortlisted the student.
  snapshot        Json
  note            String?
  decidedById     String   @db.Uuid
  createdAt       DateTime @default(now())

  jd      JobDescription @relation(fields: [jdId], references: [id], onDelete: Cascade)
  student Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([jdId, studentId])
  @@index([studentId])
}

// ---------- Job-specific preparation campaigns (M13) ----------
enum CampaignStatus {
  DRAFT
  ACTIVE
  COMPLETED
  CANCELLED
}

enum CampaignMemberStatus {
  SELECTED
  INVITED
  ACCEPTED
  DECLINED
  REMOVED
}

enum PlanItemKind {
  LEARN
  COURSE
  RESOURCE
  PRACTICE
  MOCK_TEST
  MOCK_INTERVIEW
  REVISION
}

enum PlanItemStatus {
  PENDING
  DONE
  SKIPPED
}

/// A preparation drive for one job: chosen candidates, a personal day-by-day plan for each, trainers, mock tests and interviews, and progress tracking.
/// `config` holds { mockTests: [{ scheduleId, title, date, kind }], mockInterviews: [{ title, date, kind }], resourceIds: [], milestones: [{ title, dueAt }], notify: { email, remindBehind } }.
model PrepCampaign {
  id          String         @id @default(uuid()) @db.Uuid
  collegeId   String         @db.Uuid
  jdId        String         @db.Uuid
  driveId     String?        @db.Uuid
  name        String
  company     String
  jobRole     String
  description String?
  ownerId     String         @db.Uuid
  status      CampaignStatus @default(DRAFT)
  startsAt    DateTime       @db.Date
  deadline    DateTime       @db.Date
  trainerIds  String[]       @db.Uuid
  config      Json           @default("{}")
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @default(now()) @updatedAt

  jd      JobDescription     @relation(fields: [jdId], references: [id])
  groups  CampaignGroup[]
  members CampaignMember[]
  events  CampaignEvent[]
  items   CampaignPlanItem[]

  @@index([collegeId, status])
  @@index([jdId])
}

model CampaignGroup {
  id         String  @id @default(uuid()) @db.Uuid
  campaignId String  @db.Uuid
  name       String
  trainerId  String? @db.Uuid
  sortOrder  Int     @default(0)

  campaign PrepCampaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  members  CampaignMember[]

  @@index([campaignId])
}

model CampaignMember {
  id              String               @id @default(uuid()) @db.Uuid
  campaignId      String               @db.Uuid
  studentId       String               @db.Uuid
  groupId         String?              @db.Uuid
  status          CampaignMemberStatus @default(SELECTED)
  addedManually   Boolean              @default(false)
  scoreAtAdd      Int?
  /// The skill gap report as it was when the student was invited: score, skills matched, partly matched and missing, and the explanation.
  gapReport       Json?
  invitedAt       DateTime?
  respondedAt     DateTime?
  declineReason   String?
  startedAt       DateTime?
  helpNote        String?
  helpRequestedAt DateTime?
  helpResponse    String?
  helpRespondedAt DateTime?
  readyMarkedAt   DateTime?
  readyMarkedById String?              @db.Uuid
  createdAt       DateTime             @default(now())

  campaign PrepCampaign       @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  group    CampaignGroup?     @relation(fields: [groupId], references: [id], onDelete: SetNull)
  student  Student            @relation(fields: [studentId], references: [id], onDelete: Cascade)
  items    CampaignPlanItem[]

  @@unique([campaignId, studentId])
  @@index([studentId])
}

/// One thing a student is to do on a given day. Items tied to a course, study material, mock test or mock interview tick themselves when the student finishes it there.
model CampaignPlanItem {
  id         String         @id @default(uuid()) @db.Uuid
  campaignId String         @db.Uuid
  memberId   String         @db.Uuid
  day        Int
  dueAt      DateTime
  kind       PlanItemKind
  title      String
  detail     String?
  skill      String?
  refType    String?
  refId      String?        @db.Uuid
  optional   Boolean        @default(false)
  status     PlanItemStatus @default(PENDING)
  doneAt     DateTime?
  autoDone   Boolean        @default(false)
  /// PLANNER (made by the rules), STAFF (added or changed by a person) or STUDENT.
  source     String         @default("PLANNER")
  createdAt  DateTime       @default(now())

  campaign PrepCampaign   @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  member   CampaignMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId, dueAt])
  @@index([campaignId])
}

/// Everything that changes in a campaign, with who did it.
model CampaignEvent {
  id         String   @id @default(uuid()) @db.Uuid
  campaignId String   @db.Uuid
  memberId   String?  @db.Uuid
  actorType  String
  actorId    String?  @db.Uuid
  action     String
  detail     Json     @default("{}")
  createdAt  DateTime @default(now())

  campaign PrepCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId, createdAt])
}
